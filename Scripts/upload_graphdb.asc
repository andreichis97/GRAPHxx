CC "Modeling" GET_ACT_MODEL    
CC "AdoScript" EDITBOX text:("<<GraphDB URL>> (example: http://localhost:7200)\n<<Repository ID>>") title:("Enter the URL and the GraphDB repository ID.") oktext:("Upload")

IF (endbutton != "ok")
{
    EXIT
}

SETL data:(text)

SETL filePath:(graphxxScriptsDir + "\\repository_location.txt")
SETL pythonScriptFilePath:(graphxxScriptsDir + "\\upload_graphdb.py")
CC "AdoScript" FWRITE file:(filePath) text:(data) binary:1
CC "AdoScript" SLEEP ms:1000

SETL venv_python_path:(graphxxScriptsDir + "\\.venv\\Scripts\\python.exe")

SYSTEM ("\"" + venv_python_path + "\" \"" + pythonScriptFilePath + "\"")

SETL statusPath:(graphxxScriptsDir + "\\upload_status.txt")
CC "AdoScript" FREAD file:(statusPath) binary:1
CC "AdoScript" INFOBOX (text)