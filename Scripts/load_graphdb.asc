CC "Modeling" GET_ACT_MODEL    
CC "AdoScript" EDITBOX text:("<<GraphDB URL>> (example: http://localhost:7200)\n<<Repository ID>>") title:("Enter the URL and the GraphDB repository ID.") oktext:("Upload")

IF (endbutton != "ok")
{
    EXIT
}

SETL data:(text)

SETL filePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\repository_location.txt")
SETL pythonScriptFilePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\upload_graphdb.py")
CC "AdoScript" FWRITE file:(filePath) text:(data) binary:0
CC "AdoScript" SLEEP ms:1000

SETL venv_python_path:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\.venv\\Scripts\\python.exe")

SYSTEM (venv_python_path + " " + pythonScriptFilePath)