@prefix : <http://www.example.org#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix schema: <https://schema.org/>.

:FriendsGroup rdfs:member :Mike.
:FriendsGroup rdfs:member :Anna.
:Tom a :Person.
:Person rdfs:subClassOf rdfs:Resource.
:Tom :knows :FriendsGroup.
:hasChild owl:inverseOf :hasParent.
:hasIdentifier a rdf:Property.
_:node123 a owl:Class.
:hasIdentifier rdfs:domain _:node123.
:hasIdentifier rdfs:range :Identifier.
schema:name rdfs:domain :Person.
schema:name rdfs:range xsd:string.
_:node123 a :Union.
:hasChild a rdf:Property.
:hasParent a rdf:Property.
schema:name a rdf:Property.