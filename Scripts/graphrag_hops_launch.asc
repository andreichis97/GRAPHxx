# One field per line: repository, question, hops, optional GPT model, optional GraphDB base URL.
# Keep the question on line 2. Leave lines 4 and 5 blank (or omit them) to use Python Config defaults.
# To set a URL without a model, leave line 4 blank and put the URL on line 5.
# Uses graphxxScriptsDir from the ADOxx library initialization.
SETL scriptsDirectory:(graphxxScriptsDir)
SETL pythonExecutable:(scriptsDirectory + "\\.venv\\Scripts\\python.exe")
SETL pythonScript:(scriptsDirectory + "\\graphrag_hops_semantic_similarity_v4.py")
SETL requestFile:(scriptsDirectory + "\\graphrag_khops_request.txt")
SETL resultsFile:(scriptsDirectory + "\\graphrag_khops_results.txt")

CC "Modeling" GET_ACT_MODEL
SETL actModelId: (modelid)
CC "Core" GET_ATTR_VAL objid:(actModelId) attrname:("Endpoint URL")
SETL endpointURL:(val)
CC "Core" GET_ATTR_VAL objid:(actModelId) attrname:("Repository id")
SETL repositoryId:(val)

IF(endpointURL != "" AND repositoryId != "")
{
    SETL defaultRequestText:(
        repositoryId + "\n" +
        "<<replace with actual question>>\n" +
        "<<replace with actual number of hops>>\n" +
        "<<replace with actual GPT model (optional)>>\n" +
        endpointURL
    )
}
ELSIF(endpointURL != "" AND repositoryId = "")
{
    SETL defaultRequestText:(
        "<<replace with actual repository name>>\n" +
        "<<replace with actual question>>\n" +
        "<<replace with actual hops>>\n" +
        "<<replace with actual GPT model (optional)>>\n" +
        endpointURL
    )
}
ELSIF(endpointURL = "" AND repositoryId != "")
{
    SETL defaultRequestText:(
        repositoryId + "\n" +
        "<<replace with actual question>>\n" +
        "<<replace with actual hops>>\n" +
        "<<replace with actual GPT model (optional)>>\n" +
        "<<replace with actual GraphDB URL>>(optional, example: http://localhost:7200)"
    )
}
ELSE
{
    SETL defaultRequestText:(
        "<<replace with actual repository name>>\n" +
        "<<replace with actual question>>\n" +
        "<<replace with actual hops>>\n" +
        "<<replace with actual GPT model (optional)>>\n" +
        "<<replace with actual GraphDB URL>>(optional, example: http://localhost:7200)"
    )
}


CC "AdoScript" EDITBOX
    title:("GraphRAG - repository / question / hops / optional model / optional URL")
    #text:("<<replace with actual repository name>>\n<<replace with actual question>>\n<<replace with actual hops>>\n<<replace with actual GPT model (optional)>>\n<<replace with actual GraphDB URL>>(optional, example: http://localhost:7200)\n")
    text:(defaultRequestText)
    oktext:("Execute")

IF (endbutton != "ok")
{
    EXIT
}
SETL requestText:(text)

# A fallback result prevents a previous answer from surviving a failed launch.
CC "AdoScript" FWRITE file:(resultsFile)
    text:("ERROR: Python did not produce a result. Check the Python executable, script path and dependencies.")
    binary:1
IF (ecode != 0)
{
    CC "AdoScript" ERRORBOX ("Cannot write the results file:\n" + resultsFile)
    EXIT
}

# Keep user-entered text out of the operating-system command string.
CC "AdoScript" FWRITE file:(requestFile) text:(requestText) binary:1
IF (ecode != 0)
{
    SETL errorMessage:("ERROR: Cannot write the request file:\n" + requestFile)
    CC "AdoScript" FWRITE file:(resultsFile) text:(errorMessage) binary:1
    CC "AdoScript" ERRORBOX (errorMessage)
    EXIT
}

SETL pythonCommand:(
    "\"" + pythonExecutable + "\" -X utf8 " +
    "\"" + pythonScript + "\" --request-file " +
    "\"" + requestFile + "\""
)

# SYSTEM waits for Python to finish; no SLEEP or polling is needed.
SYSTEM (pythonCommand) result:pythonExitCode

# Read even on failure: Python writes its error to the same results file.
CC "AdoScript" FREAD file:(resultsFile) binary:0
IF (ecode != 0)
{
    CC "AdoScript" ERRORBOX
        ("Cannot read the results file:\n" + resultsFile +
         "\nPython exit code: " + STR pythonExitCode)
    EXIT
}
SETL answerText:(text)
IF (LEN answerText = 0)
{
    SETL answerText:("ERROR: Python returned an empty results file.")
    CC "AdoScript" FWRITE file:(resultsFile) text:(answerText) binary:1
}

SETL resultTitle:("GraphRAG - answer")
IF (pythonExitCode != 0)
{
    SETL resultTitle:("GraphRAG - error (exit code " + STR pythonExitCode + ")")
}
CC "AdoScript" VIEWBOX title:(resultTitle) text:(answerText)
