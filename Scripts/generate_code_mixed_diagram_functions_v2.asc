            }
        }
        IF (datatypeValue != "URI" AND datatypeValue != "-" AND datatypeValue != "[" AND datatypeValue != "]" AND datatypeValue != "(" AND datatypeValue != ")")
        {
            IF(appendUri = 1)
            {
                SETL containerAttrs:(containerAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
            ELSE
            {
                SETL containerAttrs:(containerAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
        }
        IF(datatypeValue = "[")
        {
            SETL openAnonymousNode:(1)
            SETL endRow:("; ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL containerAttrs:(containerAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "[")
            }
        }
        IF(datatypeValue = "]")
        {
            SETL openAnonymousNode:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL containerAttrs:(containerAttrs + "]" + endRow)
        }
        IF(datatypeValue = "(")
        {
            SETL openList:(1)
            SETL endRow:(" ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL containerAttrs:(containerAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "(")
            }
        }
        IF(datatypeValue = ")")
        {
            SETL openList:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL containerAttrs:(containerAttrs + ")" + endRow)
        }
    }

    #Get thingidentifiers in container
    #save objids in an array in the order in which they appear in the container
    SETL aqlExpr:("{" + "\"" + containerName + "\"" + ":\"Container" + "\"" + "}<-" + "\"" + "Is inside" + "\"")
    CC "AQL" EVAL_AQL_EXPRESSION expr:(aqlExpr) modelid:(actModelId)
    SETL insideObjids:(objids)

    IF(insideObjids != "")
    {
        #for each inside object, get the X and Y position
        SETL objectsInContainerX:(array(100))
        SETL objectsInContainerY:(array(100))
        SETL unorderedObjIds:(array(100))
        SETL orderedObjIds:(array(100))
        #SETL objectsInContainerID:(array(100))
        SETL nObjects:(0)
        FOR i in:(insideObjids)
        {
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Position"
            SETL position:(val)
            SETL rawX:(token(position, 1, " ")) #x:2cm
            SETL rawX:(replall(rawX, "x:", ""))
            SETL xPoz:(replall(rawX, "cm", ""))
            SETL xPoz:(VAL xPoz)
            SETL rawY:(token(position, 2, " "))
            SETL rawY:(replall(rawY, "y:", ""))
            SETL yPoz:(replall(rawY, "cm", ""))
            SETL yPoz:(VAL yPoz)
            SETL objectsInContainerX[nObjects]:(xPoz)
            SETL objectsInContainerY[nObjects]:(yPoz)
            SETL unorderedObjIds[nObjects]:(VAL i)
            SETL nObjects:(nObjects + 1)
        }
        SETL idx:(array(100))
        FOR i from:0 to:(nObjects-1) by:(1)
        {
            SETL idx[i]:(i)
        }
        FOR i from:(1) to:(nObjects-1) by:(1)
        {  
            SETL keyIdx:(idx[i])
            SETL kx:(objectsInContainerX[keyIdx])
            SETL ky:(objectsInContainerY[keyIdx])
            SETL j:(i - 1)
            SETL bStop:(0)

            WHILE (bStop = 0)
            {
                IF (j < 0)
                {
                    SETL bStop:(1)
                }
                ELSE
                {
                    SETL cx:(objectsInContainerX[idx[j]])
                    SETL cy:(objectsInContainerY[idx[j]])
                    IF (cx > kx OR (cx = kx AND cy > ky))
                    {
                        SETL idx[j + 1]:(idx[j])
                        SETL j:(j - 1)
                    }
                    ELSE
                    {
                        SETL bStop:(1)
                    }
                }
            }

            SETL idx[j + 1]:(keyIdx)
        }

        FOR i from:0 to:(nObjects-1) by:(1)
        {
            SETL orderedObjIds[i]:(unorderedObjIds[idx[i]])
        }

        #FOR i from:0 to:(nObjects) by:(1)
        #{
        #    CC "AdoScript" VIEWBOX text:(STR orderedObjIds[i])
        #}

        CC "Core" GET_ATTR_VAL objid:(objectId) attrname:"ContainerType"
        SETL containerType:(val)

        IF(containerType = "Unordered")
        {
            FOR i from:0 to:(nObjects-1) by:(1)
            {
                CC "Core" GET_ATTR_VAL objid:(orderedObjIds[i]) attrname:"URI"
                SETL insideObjUri:(val)
                SETL containerAttrs:(containerAttrs + objUri + " rdfs:member " + insideObjUri + ".\n")
            #SETL containerAttrs:(containerAttrs + objUri + " a gml:ListContainer.\n")
            }
        }
        ELSIF(containerType = "Ordered by index")
        {
            #CC "Core" GET_ATTR_VAL objid:(orderedObjIds[0]) attrname:"URI"
            #SETL insideObjUri:(val)
            #SETL containerAttrs:(containerAttrs + objUri + " :entry " + "[ :position " + STR(i+1) + " ; " + ":item " + insideObjUri + " ], ")
            FOR i from:0 to:(nObjects-1) by:(1)
            {
                CC "Core" GET_ATTR_VAL objid:(orderedObjIds[i]) attrname:"URI"
                SETL insideObjUri:(val)
                SETL containerAttrs:(containerAttrs + objUri + " :entry " +"[ :position " + STR(i+1) + " ; " + ":item " + insideObjUri + " ].\n")
            }
        }
        ELSE
        {
            #CC "AdoScript" VIEWBOX text:(STR nObjects)
            IF(nObjects = 1)
            {
                CC "Core" GET_ATTR_VAL objid:(orderedObjIds[0]) attrname:"URI"
                SETL insideObjUri:(val)
                SETL containerAttrs:(containerAttrs + objUri + " :contains " +"( "  + insideObjUri + " ).\n")
            }
            ELSE 
            {
                SETL uris:("")
                FOR i from:0 to:(nObjects-1) by:(1)
                {
                    CC "Core" GET_ATTR_VAL objid:(orderedObjIds[i]) attrname:"URI"
                    SETL insideObjUri:(val)
                    SETL uris:(uris + insideObjUri + " ")
                }
                SETL containerAttrs:(containerAttrs + objUri + " :contains " +"( "  + uris + ").\n")
            }
        }
    }

    SETL result:(containerAttrs)           
}

PROCEDURE global GET_DATATYPE_NODE_ATTRIBUTES objectId: integer result: reference   
{
    SETL datatypeNodeAttrs:("")
    CC "Core" GET_CLASS_ID objid:(objectId)
    CC "Core" GET_ATTR_VAL objid:(objectId) attrname:"URI"
    SETL objUri:(val)
    CC "Core" GET_ATTR_VAL objid:(objectId) attrname:"Label"
    SETL objLabel:(val)
    IF(objLabel != "")
    {
        SETL datatypeNodeAttrs:(datatypeNodeAttrs + objUri + " rdfs:label \"" + objLabel + "\".\n")
    }
    
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"Attributes" #Aici de modificat si in record
    SETL attributesId:(attrid)
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(objectId) attrid:(attributesId)
	SETL openAnonymousNode:(0)
    SETL openList:(0)
    SETL appendUri:(1)
    SETL endRow:(".\n")
    FOR i in:(rowids)
	{
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
		SETL prefixValue:(val)
		CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"AttributeLocalIdentifier"
		SETL attributeLocalIdentifierValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Value"
		SETL value:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Datatype"
		SETL datatypeValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"User-defined Datatype"
		SETL userDefinedDatatypeValue:(val)
        #SETL endRow:(".\n")
        IF(datatypeValue = "-" AND userDefinedDatatypeValue != "")
        {
            #SETL datatypeValue:(userDefinedDatatypeValue)
            IF(value != "")
            {
                IF(appendUri = 1)
                {
                    SETL datatypeNodeAttrs:(datatypeNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL datatypeNodeAttrs:(datatypeNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
            }
            ELSE
            {
                IF(appendUri = 1)
                {
                    SETL datatypeNodeAttrs:(datatypeNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL datatypeNodeAttrs:(datatypeNodeAttrs + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
            }
        }
        IF(datatypeValue = "-" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL datatypeNodeAttrs:(datatypeNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
            ELSE
            {
                SETL datatypeNodeAttrs:(datatypeNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
        }
        IF(datatypeValue = "URI" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL datatypeNodeAttrs:(datatypeNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
            ELSE
            {
                SETL datatypeNodeAttrs:(datatypeNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
        }
        IF (datatypeValue != "URI" AND datatypeValue != "-" AND datatypeValue != "[" AND datatypeValue != "]" AND datatypeValue != "(" AND datatypeValue != ")")
        {
            IF(appendUri = 1)
            {
                SETL datatypeNodeAttrs:(datatypeNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
            ELSE
            {
                SETL datatypeNodeAttrs:(datatypeNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
            #}
        }
        IF(datatypeValue = "[")
        {
            SETL openAnonymousNode:(1)
            SETL endRow:("; ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL datatypeNodeAttrs:(datatypeNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "[")
            }
        }
        IF(datatypeValue = "]")
        {
            SETL openAnonymousNode:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL datatypeNodeAttrs:(datatypeNodeAttrs + "]" + endRow)
        }
        IF(datatypeValue = "(")
        {
            SETL openList:(1)
            SETL endRow:(" ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL datatypeNodeAttrs:(datatypeNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "(")
            }
        }
        IF(datatypeValue = ")")
        {
            SETL openList:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL datatypeNodeAttrs:(datatypeNodeAttrs + ")" + endRow)
        }
    }
    SETL result:(datatypeNodeAttrs)           
}

PROCEDURE global GET_PROPERTY_ATTRIBUTES objectId: integer result: reference   
