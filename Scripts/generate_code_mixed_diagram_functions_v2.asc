PROCEDURE global GET_MODEL_PREFIXES modelId: integer result: reference
{
    SETL prefixesValues:("")
    CC "Core" GET_CLASS_ID objid:(modelId)
    CC "Core" GET_CLASS_NAME classid:(classid)
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"ModelPrefixes"
    SETL modelPrefixesId:(attrid)
    #attrid
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(modelId) attrid:(modelPrefixesId)
	FOR i in:(rowids)
	{
		CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
		SETL prefixValue:(val)
		CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Dictionary"
		SETL dictionaryValue:(val)
        SETL prefixesValues:(prefixesValues + "@prefix " + prefixValue + " " + dictionaryValue + ".\n")
	}
    SETL prefixesValues:(prefixesValues + "\n")
    SETL result:(prefixesValues)
}

PROCEDURE global GET_THINGTYPE_ATTRIBUTES objectId: integer result: reference   
{
    SETL thingTypeAttrs:("")
    CC "Core" GET_CLASS_ID objid:(objectId)
    CC "Core" GET_ATTR_VAL objid:(objectId) attrname:"URI"
    SETL objUri:(val)
    CC "Core" GET_ATTR_VAL objid:(objectId) attrname:"Label"
    SETL objLabel:(val)
    IF(objLabel != "")
    {
        SETL thingTypeAttrs:(thingTypeAttrs + objUri + " rdfs:label \"" + objLabel + "\".\n")
    }
    
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"Attributes" #Aici de modificat si in record
    SETL attributesId:(attrid)
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(objectId) attrid:(attributesId)
	SETL openAnonymousNode:(0)
    SETL openList:(0)
    SETL appendUri:(1)
    SETL endRow:(".\n")
    FOR i in:(rowids)
	{
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
		SETL prefixValue:(val)
		CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"AttributeLocalIdentifier"
		SETL attributeLocalIdentifierValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Value"
		SETL value:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Datatype"
		SETL datatypeValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"User-defined Datatype"
		SETL userDefinedDatatypeValue:(val)
        #SETL endRow:(".\n")
        IF(datatypeValue = "-" AND userDefinedDatatypeValue != "")
        {
            #SETL datatypeValue:(userDefinedDatatypeValue)
            IF(value != "")
            {
                IF(appendUri = 1)
                {
                    SETL thingTypeAttrs:(thingTypeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL thingTypeAttrs:(thingTypeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
            }
            ELSE
            {
                IF(appendUri = 1)
                {
                    SETL thingTypeAttrs:(thingTypeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL thingTypeAttrs:(thingTypeAttrs + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
            }
        }
        IF(datatypeValue = "-" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL thingTypeAttrs:(thingTypeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
            ELSE
            {
                SETL thingTypeAttrs:(thingTypeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
        }
        IF(datatypeValue = "URI" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL thingTypeAttrs:(thingTypeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
            ELSE
            {
                SETL thingTypeAttrs:(thingTypeAttrs + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
        }
        IF (datatypeValue != "URI" AND datatypeValue != "-" AND datatypeValue != "[" AND datatypeValue != "]" AND datatypeValue != "(" AND datatypeValue != ")")
        {
            #IF(datatypeValue = "xsd:string" OR datatypeValue = "xsd:integer" OR datatypeValue = "xsd:float" OR datatypeValue = "xsd:decimal"
            #OR datatypeValue = "xsd:double" OR datatypeValue = "xsd:boolean" OR datatypeValue = "xsd:duration" OR datatypeValue = "xsd:dateTime"
            #OR datatypeValue = "xsd:time" OR datatypeValue = "xsd:date" OR datatypeValue = "xsd:gYear" OR datatypeValue = "xsd:gYearMonth"
            #OR datatypeValue = "xsd:gMonth" OR datatypeValue = "xsd:gMonthDay" OR datatypeValue = "xsd:gDay" OR datatypeValue = "xsd:hexBinary"
            #OR datatypeValue = "xsd:base64Binary" OR datatypeValue = "xsd:anyURI" OR datatypeValue = "xsd:QName" OR datatypeValue = "xsd:NOTATION"
            #OR datatypeValue = "xsd:token" OR datatypeValue = "xsd:language" OR datatypeValue = "xsd:nonPositiveInteger" OR datatypeValue = "xsd:negativeInteger" OR datatypeValue = "xsd:long"
            #OR dataTypeValue = "xsd:Name" OR dataTypeValue = "xsd:NMTOKEN" OR dataTypeValue = "xsd:negativeInteger" OR dataTypeValue = "xsd:int"
            #OR dataTypeValue = "xsd:unsignedLing" OR dataTypeValue = "xsd:positiveInteger" OR dataTypeValue = "xsd:NCName" OR dataTypeValue = "xsd:NMTOKENS"
            #OR dataTypeValue = "xsd:short" OR dataTypeValue = "xsd:unsignedInt" OR dataTypeValue = "xsd:ID" OR dataTypeValue = "xsd:IDREF"
            #OR dataTypeValue = "xsd:IDREFS" OR dataTypeValue = "xsd:ENTITY" OR dataTypeValue = "xsd:ENTITIES" OR dataTypeValue = "xsd:byte"
            #OR dataTypeValue = "xsd:unsignedShort" OR dataTypeValue = "xsd:unsignedByte" OR dataTypeValue = "rdf:XMLLiteral" OR dataTypeValue = "rdf:HTML")
            #{
            IF(appendUri = 1)
            {
                SETL thingTypeAttrs:(thingTypeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
            ELSE
            {
                SETL thingTypeAttrs:(thingTypeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
            #}
        }
        IF(datatypeValue = "[")
        {
            SETL openAnonymousNode:(1)
            SETL endRow:("; ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL thingTypeAttrs:(thingTypeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "[")
            }
        }
        IF(datatypeValue = "]")
        {
            SETL openAnonymousNode:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL thingTypeAttrs:(thingTypeAttrs + "]" + endRow)
        }
        IF(datatypeValue = "(")
        {
            SETL openList:(1)
            SETL endRow:(" ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL thingTypeAttrs:(thingTypeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "(")
            }
        }
        IF(datatypeValue = ")")
        {
            SETL openList:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL thingTypeAttrs:(thingTypeAttrs + ")" + endRow)
        }
    }
    SETL result:(thingTypeAttrs)           
}

PROCEDURE global GET_THINGIDENTIFIER_ATTRIBUTES objectId: integer result: reference   
{
    SETL thingIdentifierAttrs:("")
    CC "Core" GET_CLASS_ID objid:(objectId)
    CC "Core" GET_ATTR_VAL objid:(objectId) attrname:"URI"
    SETL objUri:(val)
    CC "Core" GET_ATTR_VAL objid:(objectId) attrname:"Label"
    SETL objLabel:(val)
    IF(objLabel != "")
    {
        SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " rdfs:label \"" + objLabel + "\".\n")
    }

    CC "Core" GET_ATTR_ID classid:(classid) attrname:"Multi-Language Label"
    SETL attributesId:(attrid)
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(objectId) attrid:(attributesId)
	FOR i in:(rowids)
    {
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Label"
		SETL labelValue:(val)
		CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Language"
		SETL languageValue:(val)
        IF(labelValue != "" AND languageValue != "")
        {
            SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " rdfs:label " + "\"" + labelValue + "\"" + "@" + languageValue + ".\n") #poate totusi sa schimbam numele lui :hasLabel
        }
    }
    
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"IsOfType"
    SETL attributesId:(attrid)
    CC "Core" GET_INTERREF objid:(objectId) attrid:(attributesId)
    CC "Core" GET_INTERREF_COUNT objid:(objectId) attrid:(attributesId)
    SETL intrfCount:(count)
    IF(intrfCount > 0)
    {
        FOR i from:(0) to:(intrfCount - 1)
        {
            CC "Core" GET_INTERREF objid:(objectId) attrid:(attributesId) index:(i)
            SETL modelIdToEnter:(tmodelid)
            SETL thingTypeObjName:(tobjname)
            SETL thingTypeObjClassId:(tclassid)
            CC "Modeling" IS_OPENED modelid:(modelIdToEnter)
            IF (NOT(isopened))
            {
                CC "Modeling" OPEN modelids:(modelIdToEnter)
            }
            CC "Core" GET_OBJ_ID modelid:(modelIdToEnter) classid:(thingTypeObjClassId) objname:(thingTypeObjName)
            CC "Core" GET_ATTR_VAL objid:(objid) attrname:"URI"
            SETL objTypeValue:(val)
            SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " a " + objTypeValue + ".\n")
        }
    }
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"Attributes" #Aici de modificat si in record
    SETL attributesId:(attrid)
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(objectId) attrid:(attributesId)
	SETL openAnonymousNode:(0)
    SETL openList:(0)
    SETL appendUri:(1)
    SETL endRow:(".\n")
    FOR i in:(rowids)
	{
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
		SETL prefixValue:(val)
		CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"AttributeLocalIdentifier"
		SETL attributeLocalIdentifierValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Value"
		SETL value:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Datatype"
		SETL datatypeValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"User-defined Datatype"
		SETL userDefinedDatatypeValue:(val)
        IF(datatypeValue = "-" AND userDefinedDatatypeValue != "")
        {
            IF(value != "")
            {
                IF(appendUri = 1)
                {
                    SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL thingIdentifierAttrs:(thingIdentifierAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
            }
            ELSE
            {
                IF(appendUri = 1)
                {
                    SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL thingIdentifierAttrs:(thingIdentifierAttrs + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
            }
        }
        IF(datatypeValue = "-" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
            ELSE
            {
                SETL thingIdentifierAttrs:(thingIdentifierAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
        }
        IF(datatypeValue = "URI" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
            ELSE
            {
                SETL thingIdentifierAttrs:(thingIdentifierAttrs + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
        }
        IF (datatypeValue != "URI" AND datatypeValue != "-" AND datatypeValue != "[" AND datatypeValue != "]" AND datatypeValue != "(" AND datatypeValue != ")")
        {
            IF(appendUri = 1)
            {
                SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
            ELSE
            {
                SETL thingIdentifierAttrs:(thingIdentifierAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
        }
        IF(datatypeValue = "[")
        {
            SETL openAnonymousNode:(1)
            SETL endRow:("; ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "[")
            }
        }
        IF(datatypeValue = "]")
        {
            SETL openAnonymousNode:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL thingIdentifierAttrs:(thingIdentifierAttrs + "]" + endRow)
        }
        IF(datatypeValue = "(")
        {
            SETL openList:(1)
            SETL endRow:(" ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL thingIdentifierAttrs:(thingIdentifierAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "(")
            }
        }
        IF(datatypeValue = ")")
        {
            SETL openList:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL thingIdentifierAttrs:(thingIdentifierAttrs + ")" + endRow)
        }
    }
    SETL result:(thingIdentifierAttrs)           
} 

PROCEDURE global GET_HELPER_NODE_ATTRIBUTES objectId: integer result: reference   
{
    SETL helperNodeAttrs:("")
    CC "Core" GET_CLASS_ID objid:(objectId)
    CC "Core" GET_ATTR_VAL objid:(objectId) attrname:"Local identifier"
    SETL c0:(val SUB 0)
    SETL c1:(val SUB 1)
    IF(c0 != "_" AND c1 != ":")
    {
        SETL objUri:("_:" + val)
    }
    ELSE
    {
        SETL objUri:(val)
    }
    #SETL objUri:("_:" + val)
    
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"IsOfType"
    SETL attributesId:(attrid)
    CC "Core" GET_INTERREF objid:(objectId) attrid:(attributesId)
    CC "Core" GET_INTERREF_COUNT objid:(objectId) attrid:(attributesId)
    SETL intrfCount:(count)
    IF(intrfCount > 0)
    {
        FOR i from:(0) to:(intrfCount - 1)
        {
            CC "Core" GET_INTERREF objid:(objectId) attrid:(attributesId) index:(i)
            SETL modelIdToEnter:(tmodelid)
            SETL thingTypeObjName:(tobjname)
            SETL thingTypeObjClassId:(tclassid)
            CC "Modeling" IS_OPENED modelid:(modelIdToEnter)
