		SETL prefixValue:(val)
		CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"AttributeLocalIdentifier"
		SETL attributeLocalIdentifierValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Value"
		SETL value:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Datatype"
		SETL datatypeValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"User-defined Datatype"
		SETL userDefinedDatatypeValue:(val)
        IF(datatypeValue = "-" AND userDefinedDatatypeValue != "")
        {
            IF(value != "")
            {
                IF(appendUri = 1)
                {
                    SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL helperNodeAttrs:(helperNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
            }
            ELSE
            {
                IF(appendUri = 1)
                {
                    SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL helperNodeAttrs:(helperNodeAttrs + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
            }
        }
        IF(datatypeValue = "-" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
            ELSE
            {
                SETL helperNodeAttrs:(helperNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
        }
        IF(datatypeValue = "URI" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
            ELSE
            {
                SETL helperNodeAttrs:(helperNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
        }
        IF (datatypeValue != "URI" AND datatypeValue != "-" AND datatypeValue != "[" AND datatypeValue != "]" AND datatypeValue != "(" AND datatypeValue != ")")
        {
            IF(appendUri = 1)
            {
                SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
