CC "Modeling" GET_ACT_MODEL    
CC "AdoScript" EDITBOX text:("<<Repository ID>>\n<<Query Prompt>\n<<GraphDB URL>> (example: http://localhost:7200)") title:("Enter the repository id, a query prompt for the graph and the GraphDB URL, each one on a new line") oktext:("Send")
IF (endbutton != "ok")
{
    EXIT
}

SET data:(text)

SETL filePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\chat_gpt_query_prompt.txt")
SETL venv_python_path:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\.venv\\Scripts\\python.exe")
CC "AdoScript" FWRITE file:(filePath) text:(data) binary:0

CC "AdoScript" SLEEP ms:1000

SETL filePathExec:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\openai_query.py")
SYSTEM (venv_python_path + " " + filePathExec)

#CC "AdoScript" SLEEP ms:150000
#CC "AdoScript" SLEEP ms:15000

SETL filePathReadGptData:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\openai_query_results.txt")

CC "AdoScript" FREAD file:(filePathReadGptData)
SET fileContent:(text)
CC "AdoScript" VIEWBOX text:(fileContent)