CC "Modeling" GET_ACT_MODEL
SETL actModelId: (modelid)

#initialization
SET currentObjID:(objid)
CC "Core" GET_ATTR_VAL objid:(currentObjID) attrname:"Label"
SET currentLabel:(val)

#write label to file
SET fileToWritePath:(graphxxScriptsDir + "\\label_value.txt")
CC "AdoScript" FWRITE file:(fileToWritePath) text:(currentLabel) binary:0
CC "AdoScript" SLEEP ms:1000

#call python script that will read file and will generate URI. Then the URI is written in another file
SET fileExecuteFuncPath:(graphxxScriptsDir + "\\process_label.py")
SETL venv_python_path:(
  graphxxScriptsDir + "\\.venv\\Scripts\\python.exe"
)
SYSTEM ("\"" + venv_python_path + "\" \"" + fileExecuteFuncPath + "\"")

#read the file of the generated URI and assign it in the modelling tool
#CC "AdoScript" SLEEP ms:3000
SET fileToReadPath:(graphxxScriptsDir + "\\processed_local_identifier.txt")
CC "AdoScript" FREAD file:(fileToReadPath)
SET processedLocalIdentifierVal:(text)

CC "Core" SET_ATTR_VAL objid:(currentObjID) attrname:"Local identifier" val:(processedLocalIdentifierVal)

#CC "AdoScript" VIEWBOX text:(processedUriVal)

