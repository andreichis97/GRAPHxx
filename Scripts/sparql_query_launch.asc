# Enter the repository on line 1 and the SPARQL query on line 2 (or subsequent lines).
# Optional: put the GraphDB base URL (e.g. http://localhost:7200) on a separate
# line after the complete query. Leave it blank or omit it to use the Python default.
# Uses graphxxScriptsDir from the ADOxx library initialization.
SETL scriptsDirectory:(graphxxScriptsDir)
SETL pythonExecutable:(scriptsDirectory + "\\.venv\\Scripts\\python.exe")
SETL pythonScript:(scriptsDirectory + "\\send_sparql_query.py")
SETL requestFile:(scriptsDirectory + "\\sparql_query_request.txt")
SETL resultsFile:(scriptsDirectory + "\\sparql_query_results.txt")

CC "AdoScript" EDITBOX
    title:("SPARQL - repository, query, optional URL on last line")
    text:("<<replace with actual repository name>>\n<<replace with actual SPARQL query>>\n<<replace with actual GraphDB URL (optional, example: http://localhost:7200)>>\n")
    oktext:("Execute")

IF (endbutton != "ok")
{
    EXIT
}
SETL requestText:(text)

# A fallback result prevents a previous answer from surviving a failed launch.
CC "AdoScript" FWRITE file:(resultsFile)
    text:("ERROR: Python did not produce a result. Check the Python executable, script path and dependencies.")
    binary:1
IF (ecode != 0)
{
    CC "AdoScript" ERRORBOX ("Cannot write the results file:\n" + resultsFile)
    EXIT
}

# Keep user-entered text out of the operating-system command string.
CC "AdoScript" FWRITE file:(requestFile) text:(requestText) binary:0
IF (ecode != 0)
{
    SETL errorMessage:("ERROR: Cannot write the request file:\n" + requestFile)
    CC "AdoScript" FWRITE file:(resultsFile) text:(errorMessage) binary:0
    CC "AdoScript" ERRORBOX (errorMessage)
    EXIT
}

SETL pythonCommand:(
    "\"" + pythonExecutable + "\" -X utf8 " +
    "\"" + pythonScript + "\" --request-file " +
    "\"" + requestFile + "\""
)

# SYSTEM waits for Python to finish; no SLEEP or polling is needed.
SYSTEM (pythonCommand) result:pythonExitCode

# Read even on failure: Python writes its error to the same results file.
CC "AdoScript" FREAD file:(resultsFile) binary:0
IF (ecode != 0)
{
    CC "AdoScript" ERRORBOX
        ("Cannot read the results file:\n" + resultsFile +
         "\nPython exit code: " + STR pythonExitCode)
    EXIT
}
SETL answerText:(text)
IF (LEN answerText = 0)
{
    SETL answerText:("ERROR: Python returned an empty results file.")
    CC "AdoScript" FWRITE file:(resultsFile) text:(answerText) binary:0
}

SETL resultTitle:("SPARQL - answer")
IF (pythonExitCode != 0)
{
    SETL resultTitle:("SPARQL - error (exit code " + STR pythonExitCode + ")")
}
CC "AdoScript" VIEWBOX title:(resultTitle) text:(answerText)
