PROCEDURE global IMPORT_TO_DIAGRAM modelId: integer content: string
{
    #SETL importFilePath:(".\\Graph_Modelling_Tool\\Scripts\\graphxx_import.txt")
    #SETL importFilePath:(".\\graphxx_import.txt")
    #SETL importFilePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\graphxx_import.txt")
    #D:\Andrei\ModellingTools\Graph_Modelling_Tool\Scripts\graphxx_import.txt
    #CC "AdoScript" FREAD file:(importFilePath) binary:0
    #IF (ecode <> 0) 
    #{
    #    CC "AdoScript" ERRORBOX ("Could not read the file. Error code: " + STR ecode)
    #    EXIT
    #}
    SETL fileContent:(content)
    SETL lines:(strarray(fileContent, "\n"))
    SETL lineCount:(LEN lines)
    IF (lineCount > 0) 
    {
        FOR lineIndex from:(0) to:(lineCount - 1) 
        {
            SETL currentLine:(lines[lineIndex])
            # Ignore empty lines
            IF (currentLine <> "") 
            {
                # Split the current line using |
                SETL fields:(strarray(currentLine, "|"))
                SETL fieldCount:(LEN fields)
                # Example: display the first field
                IF (fieldCount > 0) 
                {
                    IF (fields[0] = "GRAPH")
                    {
                        ADD_GRAPH_PREFIX_LOCAL_IDENTIFIER modelId:(modelId) prefix:(fields[3]) localIdentifier:(fields[4])
                    }
                    ELSIF (fields[0] = "PREFIX")
                    {
                        ADD_MODEL_PREFIX modelId:(modelId) prefix:(fields[1]) dictionary:(fields[2])
                    }
                    ELSIF (fields[0] = "NODE")
                    {
                        IF (fields[1] = "IRI" AND fields[2] = "ThingIdentifier")
                        {
                            ADD_THING_IDENTIFIER modelId:(modelId) prefix:(fields[4]) localIdentifier:(fields[5])
                        }
                        ELSIF (fields[1] = "IRI" AND fields[2] = "ThingType")
                        {
                            ADD_THING_TYPE modelId:(modelId) prefix:(fields[4]) localIdentifier:(fields[5])
                        }
                        ELSIF (fields[1] = "IRI" AND fields[2] = "DatatypeNode")
                        {
                            ADD_DATATYPE_NODE modelId:(modelId) prefix:(fields[4]) localIdentifier:(fields[5])
                        }
                        ELSIF (fields[1] = "IRI" AND fields[2] = "Container")
                        #Containers will work for the basic unordered one
                        {
                            ADD_CONTAINER modelId:(modelId) prefix:(fields[4]) localIdentifier:(fields[5])
                        }
                        ELSIF (fields[1] = "IRI" AND fields[2] = "Property")
                        {
                            ADD_PROPERTY modelId:(modelId) prefix:(fields[4]) localIdentifier:(fields[5])
                        }
                        ELSIF (fields[1] = "BNODE" AND fields[2] = "HelperNode")
                        {
                            ADD_HELPER_NODE modelId:(modelId) localIdentifier:(fields[5])
                        }
                        #functionalities not final, experimental version only
                    }
                    ELSIF (fields[0] = "ATTRIBUTE")
                    {
                        ADD_ATTRIBUTE_TO_NODE modelId:(modelId) uri:(fields[1]) nodeType:(fields[2]) prefix:(fields[4]) localIdentifier:(fields[5]) value:(fields[6]) datatype:(fields[7]) language:(fields[8])
                    }
                    ELSIF (fields[0] = "EDGE") 
                    {
                        ADD_EDGE_BETWEEN_NODES modelid:(modelId) fromNodeUri:(fields[1]) fromNodeType:(fields[2]) toNodeUri:(fields[3]) toNodeType:(fields[4]) connectorPrefix:(fields[6]) connectorLocalIdentifier:(fields[7]) connectorType:(fields[8])
                    }
                }
            }
        }

    }
}
PROCEDURE global DELETE_EXISTING_MODEL_PREFIXES modelId: integer
{
    CC "Core" GET_CLASS_ID objid:(modelId)
    CC "Core" GET_CLASS_NAME classid:(classid)
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"ModelPrefixes"
    SETL modelPrefixesId:(attrid)
    CC "Core" GET_REC_ATTR_ROW_COUNT objid:(modelId) attrid:(modelPrefixesId)
    SETL rowCount:(count)
	FOR i from:(0) to:(rowCount) by:(1)
	{
        CC "Core" GET_REC_ATTR_ROW_ID objid:(modelid) attrid:(modelPrefixesId) index:1
        CC "Core" REMOVE_REC_ROW objid:(modelId) attrid:(modelPrefixesId) rowid:(rowid)
	}
}

PROCEDURE global ADD_GRAPH_PREFIX_LOCAL_IDENTIFIER modelId: integer prefix: string localIdentifier: string
{
    CC "Core" SET_ATTR_VAL objid:(modelId) attrname:"TriG Graph Prefix" val:(prefix)
    CC "Core" SET_ATTR_VAL objid:(modelId) attrname:"TriG Graph Local identifier" val:(localIdentifier)
}

PROCEDURE global ADD_MODEL_PREFIX modelId: integer prefix: string dictionary: string
{
    #SETL prefixesValues:("")
    CC "Core" GET_CLASS_ID objid:(modelId)
    CC "Core" GET_CLASS_NAME classid:(classid)
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"ModelPrefixes"
    SETL modelPrefixesId:(attrid)
    #attrid
    CC "Core" ADD_REC_ROW objid:(modelId) attrid:(modelPrefixesId)
    SETL newRowId:(rowid)
    CC "Core" SET_ATTR_VAL objid:(newRowId) attrname:"Prefix" val:(prefix)
    CC "Core" SET_ATTR_VAL objid:(newRowId) attrname:"Dictionary" val:(dictionary)
}

PROCEDURE global ADD_THING_IDENTIFIER modelId: integer prefix: string localIdentifier: string
{
    CC "Core" GET_CLASS_ID classname:("ThingIdentifier")
    CC "Core" CREATE_OBJ modelid:(modelId) classid:(classid)
    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Prefix" val:(prefix)
    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Local identifier" val:(localIdentifier)
    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Name" val:(prefix+localIdentifier)
}

