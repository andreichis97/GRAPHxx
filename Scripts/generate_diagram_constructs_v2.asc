PROCEDURE global ADD_ATTRIBUTE_TO_NODE modelId: integer uri: string nodeType: string prefix: string localIdentifier: string value: string datatype: string language: string
{
    CC "Core" GET_CLASS_ID classname:(nodeType)
    SETL nodeClassId:(classid)

    CC "Core" GET_OBJ_ID modelid:(modelId) classid:(nodeClassId) objname:(uri)
    IF(ecode = 0)
    {
        SETL nodeObjId:(objid)
        IF((prefix+localIdentifier) = "rdfs:label")
        {
            CC "Core" SET_ATTR_VAL objid:(nodeObjId) attrname:"Label" val:(value)
        }
        ELSE 
        {
            CC "Core" GET_ATTR_ID classid:(nodeClassId) attrname:"Attributes"
            CC "Core" ADD_REC_ROW objid:(nodeObjId) attrid:(attrid)
            CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Prefix" val:(prefix)
            CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"AttributeLocalIdentifier" val:(localIdentifier)
            CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Value" val:(value)
            CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Datatype" val:(datatype)
        }
    }
}

PROCEDURE global ADD_EDGE_BETWEEN_NODES modelid: integer fromNodeUri: string fromNodeType: string toNodeUri: string toNodeType: string connectorPrefix: string connectorLocalIdentifier: string connectorType: string
{
    CC "Core" GET_CLASS_ID classname:(fromNodeType)
    SETL fromClassId:(classid)
    CC "Core" GET_CLASS_ID classname:(toNodeType)
    SETL toClassId:(classid)

    CC "Core" GET_OBJ_ID modelid:(modelId) classid:(fromClassId) objname:(fromNodeUri)
    SETL fromObjId:(objid)

    CC "Core" GET_OBJ_ID modelid:(modelId) classid:(toClassId) objname:(toNodeUri)
    SETL toObjId:(objid)

    IF(connectorType = "GENERIC")
    {
        CC "Core" GET_CLASS_ID relation classname:("RelatedTo")
        CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(fromObjId) toobjid:(toObjId) classid:(classid)
        CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Prefix" val:(connectorPrefix)
        CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Local identifier" val:(connectorLocalIdentifier)
    }
    ELSIF(connectorType = "TYPE")
    {
        CC "Core" GET_CLASS_ID relation classname:("IsOfType")
        CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(fromObjId) toobjid:(toObjId) classid:(classid)
    }
    ELSIF(connectorType = "DOMAIN")
    {
        CC "Core" GET_CLASS_ID relation classname:("From")
        CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(fromObjId) toobjid:(toObjId) classid:(classid)
    }
    ELSIF(connectorType = "RANGE")
    {
        CC "Core" GET_CLASS_ID relation classname:("To")
        CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(fromObjId) toobjid:(toObjId) classid:(classid)
    }
    ELSIF(connectorType = "SUBPROPERTY")
    {
        CC "Core" GET_CLASS_ID relation classname:("IsAKindOf")
        CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(fromObjId) toobjid:(toObjId) classid:(classid)
    }
    ELSIF(connectorType = "SUBCLASS")
    {
        CC "Core" GET_CLASS_ID relation classname:("IsAKindOf")
        CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(fromObjId) toobjid:(toObjId) classid:(classid)
    }
    ELSIF(connectorType = "SAME_AS")
    {
        CC "Core" GET_CLASS_ID relation classname:("IsTheSame")
        CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(fromObjId) toobjid:(toObjId) classid:(classid)
    }
}

PROCEDURE global EXECUTE_LAYOUT modelId: integer
{
    CC "Drawing" CREATE_LAYOUT_ALGORITHM "Without swimlanes"
    name:"temp"
    orientation:horizontal
    raster-width:3cm
    raster-height:2cm

    CC "Drawing" EXEC_LAYOUT_ALGORITHM
        name:"temp"
        modelid:(modelId)

    CC "Drawing" DELETE_LAYOUT_ALGORITHM name:"temp"
}

PROCEDURE global APPLY_GRAPHXX_LAYOUT modelId:integer
{
    SETL layoutAlgorithmName:("GraphXX Import Layout")

    ###########################################################################
    # 1. EXECUTE GENERAL LAYOUT
    ###########################################################################

    CC "Drawing" CREATE_LAYOUT_ALGORITHM "Without swimlanes"
        name:(layoutAlgorithmName)
        orientation:horizontal
        raster-width:7cm
        raster-height:5cm

    IF (ecode <> 0)
    {
        CC "AdoScript" ERRORBOX
            ("Could not create the layout algorithm. Error: " + STR ecode)
        EXIT
    }

    CC "Drawing" EXEC_LAYOUT_ALGORITHM
        name:(layoutAlgorithmName)
        modelid:(modelId)

    SETL layoutError:(ecode)

    CC "Drawing" DELETE_LAYOUT_ALGORITHM
        name:(layoutAlgorithmName)

    IF (layoutError <> 0)
    {
        CC "AdoScript" ERRORBOX
            ("Could not execute the layout algorithm. Error: " +
             STR layoutError)
        EXIT
    }

    ###########################################################################
    # 2. PROCESS RDF CONTAINERS
    ###########################################################################

    PROCESS_RDFS_MEMBER_CONTAINERS modelId:(modelId)
}


PROCEDURE global PROCESS_RDFS_MEMBER_CONTAINERS modelId:integer
{
    ###########################################################################
    # CONFIGURATION
    ###########################################################################

    SETL containerClassName:("Container")
    SETL membershipURI:("rdfs:member")

    # Maximum number of objects placed in one row.
    SETL maxColumns:(3)

    # Space allocated to each member node.
    SETL cellWidth:(6cm)
    SETL cellHeight:(4cm)

    # Space between the container border and its members.
    SETL horizontalPadding:(2cm)
    SETL verticalPadding:(2cm)

    # Space reserved at the top for the container name.
    SETL headerHeight:(2.5cm)

    # Debug output. Change to 0 after testing.
    SETL debugMode:(1)

    ###########################################################################
    # DEBUG COUNTERS
    ###########################################################################

    SETL containerCount:(0)
    SETL membershipConnectorCount:(0)
    SETL movedMemberCount:(0)
    SETL deletedConnectorCount:(0)
    SETL positionErrorCount:(0)

    ###########################################################################
    # 1. GET ALL CONTAINERS
    ###########################################################################

    CC "Core" GET_ALL_OBJS_OF_CLASSNAME
        modelid:(modelId)
        classname:(containerClassName)

    IF (ecode <> 0)
    {
        CC "AdoScript" ERRORBOX
            ("Could not retrieve Container instances. Error: " +
             STR ecode)
        EXIT
    }

    SETL containerIds:(objids)
    SET containerCount:(LEN containerIds)

    IF (containerIds = "")
    {
        IF (debugMode = 1)
        {
            CC "AdoScript" INFOBOX
                ("No instances of class \"" +
                 containerClassName +
                 "\" were found.")
        }

        EXIT
    }

    ###########################################################################
    # 2. GET ALL CONNECTORS
    #
    # We save this result because every subsequent Core command can overwrite
    # the global return variable objids.
    ###########################################################################

    CC "Core" GET_ALL_CONNECTORS
        modelid:(modelId)

    IF (ecode <> 0)
    {
        CC "AdoScript" ERRORBOX
            ("Could not retrieve the model connectors. Error: " +
             STR ecode)
        EXIT
    }

    SETL allConnectorIds:(objids)

    ###########################################################################
    # 3. PROCESS EACH CONTAINER
    ###########################################################################

    FOR containerIdToken in:(containerIds)
    {
        SETL containerId:(VAL containerIdToken)

        SETL memberIds:(array(0))
        SETL memberConnectorIds:(array(0))

        #######################################################################
        # 3.1 FIND ALL rdfs:member CONNECTORS ATTACHED TO THIS CONTAINER
        #######################################################################

        FOR connectorIdToken in:(allConnectorIds)
        {
            SETL connectorId:(VAL connectorIdToken)

            ###################################################################
            # Force the URI attribute into a string representation.
            ###################################################################

            CC "Core" debug GET_ATTR_VAL
                objid:(connectorId)
                attrname:"URI"
                as-string

            IF (ecode = 0)
            {
                SETL connectorURI:(val)

                IF (connectorURI = membershipURI)
                {
                    CC "Core" GET_CONNECTOR_ENDPOINTS
                        objid:(connectorId)

                    IF (ecode = 0)
                    {
                        # Save the return values immediately because another
                        # Core call could overwrite them.
                        SETL connectorFromId:(fromobjid)
                        SETL connectorToId:(toobjid)

                        #######################################################
                        # Normal RDF direction:
                        #
                        # Container --rdfs:member--> Member
                        #######################################################

                        IF (connectorFromId = containerId)
                        {
                            SETL appendResult:
                                (aappend(memberIds, connectorToId))

                            SET appendResult:
                                (aappend(memberConnectorIds, connectorId))

                            SET membershipConnectorCount:
                                (membershipConnectorCount + 1)
                        }

                        #######################################################
                        # Also support the relation being drawn in reverse.
                        #######################################################

                        ELSIF (connectorToId = containerId)
                        {
                            SETL appendResult:
                                (aappend(memberIds, connectorFromId))

                            SET appendResult:
                                (aappend(memberConnectorIds, connectorId))

                            SET membershipConnectorCount:
                                (membershipConnectorCount + 1)
                        }
                    }
                }
            }
        }

        #######################################################################
        # 3.2 CALCULATE CONTAINER GRID
        #######################################################################

        SETL memberCount:(LEN memberIds)

        IF (memberCount > 0)
        {
            SETL columnCount:(memberCount)

            IF (columnCount > maxColumns)
            {
                SET columnCount:(maxColumns)
            }

            # Calculate ceil(memberCount / columnCount).
            SETL rowCount:(0)
            SETL remainingMembers:(memberCount)

            WHILE (remainingMembers > 0)
            {
                SET rowCount:(rowCount + 1)
                SET remainingMembers:
                    (remainingMembers - columnCount)
            }

            ###################################################################
            # 3.3 READ THE CURRENT CONTAINER POSITION
            ###################################################################

            CC "Core" GET_ATTR_VAL
                objid:(containerId)
                attrname:"Position"
                as-string

            IF (ecode = 0)
            {
                SETL oldContainerPosition:(val)

                LEO parse:(oldContainerPosition)
                    get-tmm-value:containerX:"x"
                    get-tmm-value:containerY:"y"

                ################################################################
                # Calculate required container dimensions.
                ################################################################

                SETL containerWidth:
                    (horizontalPadding +
                     columnCount * cellWidth +
                     horizontalPadding)

                SETL containerHeight:
                    (headerHeight +
                     verticalPadding +
                     rowCount * cellHeight +
                     verticalPadding)

                ################################################################
                # Build the compound Position value.
                #
                # STR on a measure value keeps its measurement unit.
                ################################################################

                SETL newContainerPosition:
                    ("NODE x:" + STR containerX +
                     " y:" + STR containerY +
                     " w:" + STR containerWidth +
                     " h:" + STR containerHeight +
                     " index:0")

                ################################################################
                # Position is a compound attribute, so use as-string.
                ################################################################

                CC "Core" SET_ATTR_VAL
                    objid:(containerId)
                    attrname:"Position"
                    val:(newContainerPosition)
                    as-string

                IF (ecode = 0)
                {
                    ############################################################
                    # Synchronize the graphical representation after resizing.
                    ############################################################

                    CC "Modeling" REBUILD_DRAWING_AREA
                        modelid:(modelId)

                    ############################################################
                    # Calculate the internal top-left position.
                    #
                    # The container's x/y GraphRep origin is assumed to be its
                    # centre.
                    ############################################################

                    SETL containerLeft:
                        (containerX - containerWidth / 2)

                    SETL containerTop:
                        (containerY - containerHeight / 2)

                    ############################################################
                    # 3.4 MOVE MEMBERS INSIDE THE CONTAINER
                    ############################################################

                    SETL memberIndex:(0)
                    SETL currentColumn:(0)
                    SETL currentRow:(0)

                    WHILE (memberIndex < memberCount)
                    {
                        SETL memberId:
                            (memberIds[memberIndex])

                        SETL memberX:
                            (containerLeft +
                             horizontalPadding +
                             cellWidth / 2 +
                             currentColumn * cellWidth)

                        SETL memberY:
                            (containerTop +
                             headerHeight +
                             verticalPadding +
                             cellHeight / 2 +
                             currentRow * cellHeight)

                        CC "Modeling" SET_OBJ_POS
                            objid:(memberId)
                            x:(memberX)
                            y:(memberY)

                        IF (ecode = 0)
                        {
                            SET movedMemberCount:
                                (movedMemberCount + 1)
                        }
                        ELSE
                        {
                            SET positionErrorCount:
                                (positionErrorCount + 1)
                        }

                        SET currentColumn:
                            (currentColumn + 1)

                        IF (currentColumn >= columnCount)
                        {
                            SET currentColumn:(0)
                            SET currentRow:(currentRow + 1)
                        }

                        SET memberIndex:(memberIndex + 1)
                    }

                    ############################################################
                    # 3.5 DELETE rdfs:member CONNECTORS
                    ############################################################

                    SETL connectorIndex:(0)
                    SETL connectorCount:(LEN memberConnectorIds)

                    WHILE (connectorIndex < connectorCount)
                    {
                        SETL connectorId:
                            (memberConnectorIds[connectorIndex])

                        CC "Core" DELETE_CONNECTOR
                            modelid:(modelId)
                            objid:(connectorId)

                        IF (ecode = 0)
                        {
                            SET deletedConnectorCount:
                                (deletedConnectorCount + 1)
                        }

                        SET connectorIndex:
                            (connectorIndex + 1)
                    }
                }
                ELSE
                {
                    SET positionErrorCount:
                        (positionErrorCount + 1)
                }
            }
            ELSE
            {
                SET positionErrorCount:
                    (positionErrorCount + 1)
            }
        }
    }

    ###########################################################################
    # 4. FINAL REFRESH
    ###########################################################################

    CC "Modeling" REBUILD_DRAWING_AREA
        modelid:(modelId)

    ###########################################################################
    # 5. DEBUG SUMMARY
    ###########################################################################

    IF (debugMode = 1)
    {
        CC "AdoScript" INFOBOX
            ("Container processing completed." +
             "\n\nContainers found: " +
             STR containerCount +
             "\nrdfs:member connectors found: " +
             STR membershipConnectorCount +
             "\nMember nodes moved: " +
             STR movedMemberCount +
             "\nConnectors deleted: " +
             STR deletedConnectorCount +
             "\nPosition errors: " +
             STR positionErrorCount)
    }
}

PROCEDURE global GENERATE_GRAPHXX_IMPORT_FILE result: reference
{
    SETL pythonExecutable:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\.venv\\Scripts\\python.exe")
    SETL pythonScriptPath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\rdf_to_graphxx.py")

    SETL inputFilePath:("")
    SETL graphxxImportPath:("")

    # ------------------------------------------------------------------
    # STEP 1: ASK USER FOR THE RDF INPUT METHOD
    # ------------------------------------------------------------------

    CC "AdoScript" LISTBOX
        entries:("Paste RDF graph;Select RDF file")
        toksep:(";")
        title:("Import RDF graph")
        boxtext:("Choose how you want to provide the RDF graph:")
        oktext:("Continue")
        selection:("Paste RDF graph")

    IF (endbutton != "ok")
    {
        EXIT
    }

    SETL inputMethod:(selection)

    # ------------------------------------------------------------------
    # STEP 2A: RDF GRAPH PASTED IN AN ADOXX WINDOW
    # ------------------------------------------------------------------

    IF (inputMethod = "Paste RDF graph")
    {
        CC "AdoScript" EDITBOX
            text:("")
            title:("Paste RDF graph")
            oktext:("Import")
            fontname:("Consolas")
            fontheight:(10)

        IF (endbutton != "ok")
        {
            EXIT
        }

        SETL rdfContent:(text)

        IF (LEN rdfContent = 0)
        {
            CC "AdoScript" ERRORBOX
                ("No RDF content was provided.")
                title:("RDF import")

            EXIT
        }

        # Generate a unique temporary filename.
        CC "AdoScript" GET_TEMP_FILENAME

        SETL inputFilePath:(filename + ".txt")
        SETL temporaryInputCreated:(1)

        # Convert the ADOxx string to UTF-8 and preserve line endings.
        CC "AdoScript" FWRITE
            file:(inputFilePath)
            text:(toutf8(rdfContent))
            binary:(1)

        IF (ecode != 0)
        {
            CC "AdoScript" ERRORBOX
                ("The temporary RDF input file could not be created.\n\n" +
                "Path: " + inputFilePath +
                "\nError code: " + STR ecode)
                title:("RDF import")

            EXIT
        }
    }


    # ------------------------------------------------------------------
    # STEP 2B: USER SELECTS AN EXISTING RDF FILE
    # ------------------------------------------------------------------

    ELSIF (inputMethod = "Select RDF file")
    {
        CC "AdoScript" FILE_DIALOG open
            filter1:("Turtle files (*.ttl)")
            type1:("**.ttl")
            filter2:("TriG files (*.trig)")
            type2:("**.trig")
            filter3:("Text files (*.txt)")
            type3:("**.txt")
            filter4:("All files")
            type4:("**.*")

        IF (endbutton != "ok")
        {
            EXIT
        }

        SETL inputFilePath:(path)
    }


    # ------------------------------------------------------------------
    # STEP 3: CREATE A UNIQUE OUTPUT FILE
    # ------------------------------------------------------------------

    CC "AdoScript" GET_TEMP_FILENAME

    SETL graphxxImportPath:(filename + "_graphxx_import.txt")


    # ------------------------------------------------------------------
    # STEP 4: INVOKE THE PYTHON CONVERTER
    # ------------------------------------------------------------------

    SETL pythonCommand:(
        "\"" + pythonExecutable + "\"" +
        " \"" + pythonScriptPath + "\"" +
        " --input \"" + inputFilePath + "\"" +
        " --output \"" + graphxxImportPath + "\""
    )

    SYSTEM (pythonCommand) result:pythonExitCode

    IF (pythonExitCode != 0)
    {
        CC "AdoScript" ERRORBOX
            ("The RDF conversion failed.\n\n" +
            "Python exit code: " + STR pythonExitCode +
            "\nInput file: " + inputFilePath)
            title:("RDF import")

        EXIT
    }

    # ------------------------------------------------------------------
    # STEP 5: READ THE GENERATED GRAPHXX IMPORT FILE
    # ------------------------------------------------------------------

    CC "AdoScript" FREAD
        file:(graphxxImportPath)
        binary:(0)

    IF (ecode != 0)
    {
        CC "AdoScript" ERRORBOX
            ("The generated GraphXX import file could not be read.\n\n" +
            "Path: " + graphxxImportPath +
            "\nError code: " + STR ecode)
            title:("RDF import")

        EXIT
    }

    SETL fileContent:(text)

    IF (LEN fileContent = 0)
    {
        CC "AdoScript" ERRORBOX
            ("The Python converter generated an empty import file.")
            title:("RDF import")

        EXIT
    }
    SETL result:(fileContent)
}

###MAIN
CC "Modeling" GET_ACT_MODEL
SETL actModelId: (modelid)

GENERATE_GRAPHXX_IMPORT_FILE result: fileContent
DELETE_EXISTING_MODEL_PREFIXES modelId:(actModelId)
IMPORT_TO_DIAGRAM modelId:(actModelId) content:(fileContent) 
EXECUTE_LAYOUT modelId:(actModelId)
#APPLY_GRAPHXX_LAYOUT modelId:(actModelId)
