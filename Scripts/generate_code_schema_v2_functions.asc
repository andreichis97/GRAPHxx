PROCEDURE global GET_HELPERNODE_ATTRIBUTES objectId: integer result: reference   
{
    SETL helperNodeAttrs:("")
    CC "Core" GET_CLASS_ID objid:(objectId)
    CC "Core" GET_ATTR_VAL objid:(objectId) attrname:"Local identifier"
    SETL c0:(val SUB 0)
    SETL c1:(val SUB 1)
    IF(c0 != "_" AND c1 != ":")
    {
        SETL objUri:("_:" + val)
    }
    ELSE
    {
        SETL objUri:(val)
    }
    #SETL objUri:("_:" + val)
    
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"IsOfType"
    SETL attributesId:(attrid)
    CC "Core" GET_INTERREF objid:(objectId) attrid:(attributesId)
    CC "Core" GET_INTERREF_COUNT objid:(objectId) attrid:(attributesId)
    SETL intrfCount:(count)
    IF(intrfCount > 0)
    {
        FOR i from:(0) to:(intrfCount - 1)
        {
            CC "Core" GET_INTERREF objid:(objectId) attrid:(attributesId) index:(i)
            SETL modelIdToEnter:(tmodelid)
            SETL thingTypeObjName:(tobjname)
            SETL thingTypeObjClassId:(tclassid)
            CC "Modeling" IS_OPENED modelid:(modelIdToEnter)
            IF (NOT(isopened))
            {
                CC "Modeling" OPEN modelids:(modelIdToEnter)
            }
            CC "Core" GET_OBJ_ID modelid:(modelIdToEnter) classid:(thingTypeObjClassId) objname:(thingTypeObjName)
            CC "Core" GET_ATTR_VAL objid:(objid) attrname:"URI"
            SETL objTypeValue:(val)
            SETL helperNodeAttrs:(helperNodeAttrs + objUri + " a " + objTypeValue + ".\n")
        }
    }
    CC "Core" GET_ATTR_ID classid:(classid) attrname:"Attributes" #Aici de modificat si in record
    SETL attributesId:(attrid)
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(objectId) attrid:(attributesId)
	SETL openAnonymousNode:(0)
    SETL openList:(0)
    SETL appendUri:(1)
    SETL endRow:(".\n")
    FOR i in:(rowids)
	{
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
		SETL prefixValue:(val)
		CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"AttributeLocalIdentifier"
		SETL attributeLocalIdentifierValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Value"
		SETL value:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Datatype"
		SETL datatypeValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"User-defined Datatype"
		SETL userDefinedDatatypeValue:(val)
        IF(datatypeValue = "-" AND userDefinedDatatypeValue != "")
        {
            IF(value != "")
            {
                IF(appendUri = 1)
                {
                    SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL helperNodeAttrs:(helperNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + userDefinedDatatypeValue + endRow)
                }
            }
            ELSE
            {
                IF(appendUri = 1)
                {
                    SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
                ELSE
                {
                    SETL helperNodeAttrs:(helperNodeAttrs + prefixValue + attributeLocalIdentifierValue + " a " + userDefinedDatatypeValue + endRow)
                }
            }
        }
        IF(datatypeValue = "-" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
            ELSE
            {
                SETL helperNodeAttrs:(helperNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
        }
        IF(datatypeValue = "URI" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
            ELSE
            {
                SETL helperNodeAttrs:(helperNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
        }
        IF (datatypeValue != "URI" AND datatypeValue != "-" AND datatypeValue != "[" AND datatypeValue != "]" AND datatypeValue != "(" AND datatypeValue != ")")
        {
            IF(appendUri = 1)
            {
                SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
            ELSE
            {
                SETL helperNodeAttrs:(helperNodeAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
        }
        IF(datatypeValue = "[")
        {
            SETL openAnonymousNode:(1)
            SETL endRow:("; ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "[")
            }
        }
        IF(datatypeValue = "]")
        {
            SETL openAnonymousNode:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL helperNodeAttrs:(helperNodeAttrs + "]" + endRow)
        }
        IF(datatypeValue = "(")
        {
            SETL openList:(1)
            SETL endRow:(" ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL helperNodeAttrs:(helperNodeAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "(")
            }
        }
        IF(datatypeValue = ")")
        {
            SETL openList:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL helperNodeAttrs:(helperNodeAttrs + ")" + endRow)
        }
    }
    SETL result:(helperNodeAttrs)           
}

PROCEDURE global GET_CONNECTOR_RELATION connectorObjectId: integer fromObjectId: integer toObjectId: integer result: reference
{
    SETL connectorRelation:("")
    CC "Core" GET_CLASS_ID objid:(connectorObjectId)
    CC "Core" GET_CLASS_NAME classid:(classid)
    SETL connectorClassName:(classname)
    CC "Core" GET_ATTR_VAL objid:(connectorObjectId) attrname:"URI"
    SETL connectorUri:(val)
    CC "Core" GET_CLASS_ID objid:(toObjectId)
    CC "Core" GET_CLASS_NAME classid:(classid)
    SETL toObjClassName:(classname)
    CC "Core" GET_CLASS_ID objid:(fromObjectId)
    CC "Core" GET_CLASS_NAME classid:(classid)
    SETL fromObjClassName:(classname)
    IF(toObjClassName = "HelperNode")
    {
        CC "Core" GET_ATTR_VAL objid:(toObjectId) attrname:"Local identifier"
        SETL toObjUri:("_:" + val)
    }
    ELSE
    {
        CC "Core" GET_ATTR_VAL objid:(toObjectId) attrname:"URI"
        SETL toObjUri:(val)
    }
    IF(fromObjClassName = "HelperNode")
    {
        CC "Core" GET_ATTR_VAL objid:(fromObjectId) attrname:"Local identifier"
        SETL fromObjUri:("_:" + val)
    }
    ELSE
    {
        CC "Core" GET_ATTR_VAL objid:(fromObjectId) attrname:"URI"
        SETL fromObjUri:(val)
    }
    
    IF(connectorClassName = "IsOfType")
    {
        IF((fromObjClassName = "ThingType" OR fromObjClassName = "Property" OR fromObjClassName = "HelperNode" OR fromObjClassName = "DatatypeNode") AND toObjClassName = "ThingType")
        {
            SETL connectorRelation:(fromObjUri + " a " + toObjUri + ".\n")
        }
    }
    ELSIF(connectorClassName = "RelatedTo")
    {
        IF(fromObjClassName = "ThingType" AND (toObjClassName = "ThingType" OR toObjClassName = "HelperNode" OR toObjClassName = "Property" OR toObjClassName = "DatatypeNode"))
        {
            SETL connectorRelation:(fromObjUri + " " + connectorUri + " " + toObjUri + ".\n")
        }
        ELSIF(fromObjClassName = "HelperNode" AND (toObjClassName = "ThingType" OR toObjClassName = "HelperNode" OR toObjClassName = "Property" OR toObjClassName = "DatatypeNode"))
        {
            SETL connectorRelation:(fromObjUri + " " + connectorUri + " " + toObjUri + ".\n")
        }
        ELSIF(fromObjClassName = "DatatypeNode" AND (toObjClassName = "ThingIdentifier" OR toObjClassName = "HelperNode" OR toObjClassName = "Property" OR toObjClassName = "DatatypeNode"))
        {
            SETL connectorRelation:(fromObjUri + " " + connectorUri + " " + toObjUri + ".\n")
        }
        ELSIF(fromObjClassName = "Property" AND (toObjClassName = "ThingType" OR toObjClassName = "HelperNode" OR toObjClassName = "Property" OR toObjClassName = "DatatypeNode"))
        {
            SETL connectorRelation:(fromObjUri + " " + connectorUri + " " + toObjUri + ".\n")
        }
    }
    ELSIF(connectorClassName = "From")
    {
        IF(fromObjClassName = "Property" AND (toObjClassName = "ThingType" OR toObjClassName = "HelperNode" OR toObjClassName = "Property"))
        {
            SETL connectorRelation:(fromObjUri + " rdfs:domain " + toObjUri + ".\n")
        }
    }
    ELSIF(connectorClassName = "To")
    {
        IF(fromObjClassName = "Property" AND (toObjClassName = "ThingType" OR toObjClassName = "HelperNode" OR toObjClassName = "Property" OR toObjClassName = "DatatypeNode"))
        {
            SETL connectorRelation:(fromObjUri + " rdfs:range " + toObjUri + ".\n")
        }
    }
    ELSIF(connectorClassName = "IsAKindOf")
    {
        IF(fromObjClassName = "ThingType" AND toObjClassName = "ThingType")
        {
            SETL connectorRelation:(fromObjUri + " rdfs:subClassOf " + toObjUri + ".\n")
        }
        IF(fromObjClassName = "Property" AND toObjClassName = "Property")
        {
            SETL connectorRelation:(fromObjUri + " rdfs:subPropertyOf " + toObjUri + ".\n")
        }
    }
    ELSIF(connectorClassName = "IsTheSame")
    {
        IF(fromObjClassName = "ThingType" AND toObjClassName = "ThingType")
        {
            SETL connectorRelation:(fromObjUri + " owl:equivalentClass " + toObjUri + ".\n")
        }
        ELSIF(fromObjClassName = "Property" AND toObjClassName = "Property")
        {
            SETL connectorRelation:(fromObjUri + " owl:equivalentProperty " + toObjUri + ".\n")
        }
    }
    SETL result:(connectorRelation)
}

#-------------------------------------------------------------------------------------------------------------------------------------------------#

CC "Modeling" GET_ACT_MODEL
SETL actModelId: (modelid)

CC "Core" GET_ATTR_VAL objid:(actModelId) attrname:"TriG Graph Prefix"
SETL modelPrefix:(val)

CC "Core" GET_ATTR_VAL objid:(actModelId) attrname:"TriG Graph Local identifier"
SETL modelLocalIdentifier:(val)

SETL prefixes:("")
SETL endMessage:("")
GET_MODEL_PREFIXES modelId:(actModelId) result:prefixes

IF(modelPrefix != "" AND modelLocalIdentifier != "")
{
    SETL message:(modelPrefix + modelLocalIdentifier + "\n" + "{" + "\n")
    SETL message:(prefixes + message)
    SETL endMessage:("\n" + "}")

}
ELSE
{
    SETL message:("")
    SETL message:(message + prefixes)
}

EXECUTE file:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\add_uris_all_objects_serialization.asc")

#thing types
CC "Core" GET_ALL_OBJS_OF_CLASSNAME modelid:(actModelId) classname:"ThingType"
SETL thingTypesObjids:(objids)
FOR i in:(thingTypesObjids)
{
    GET_THINGTYPE_ATTRIBUTES objectId:(VAL i) result:objAttrs
    SETL message:(message + objAttrs)
    SETL objAttrs:("")
}

#datatype nodes
CC "Core" GET_ALL_OBJS_OF_CLASSNAME modelid:(actModelId) classname:"DatatypeNode"
SETL datatypeNodesObjids:(objids)
FOR i in:(datatypeNodesObjids)
{
    GET_DATATYPE_NODE_ATTRIBUTES objectId:(VAL i) result:objAttrs
    SETL message:(message + objAttrs)
    SETL objAttrs:("")
}

#helper nodes
CC "Core" GET_ALL_OBJS_OF_CLASSNAME modelid:(actModelId) classname:"HelperNode"
SETL helperNodesObjids:(objids)
FOR i in:(helperNodesObjids)
{
    GET_HELPER_NODE_ATTRIBUTES objectId:(VAL i) result:objAttrs
    SETL message:(message + objAttrs)
    SETL objAttrs:("")
}

#properties
CC "Core" GET_ALL_OBJS_OF_CLASSNAME modelid:(actModelId) classname:"Property"
SETL propertyObjids:(objids)
FOR i in:(propertyObjids)
{
    GET_PROPERTY_ATTRIBUTES objectId:(VAL i) result:objAttrs
    SETL message:(message + objAttrs)
    SETL objAttrs:("")
}

#connectors
CC "Core" GET_ALL_CONNECTORS modelid:(actModelId)
SETL connectors:(objids)
FOR i in:(connectors)
{
    SETL connectorRelation:("")
    #Connector objid VAL i
    CC "Core" GET_CONNECTOR_ENDPOINTS objid:(VAL i)
    #fromobjid and toobjid
    GET_CONNECTOR_RELATION connectorObjectId: (VAL i) fromObjectId: (fromobjid) toObjectId: (toobjid) result: connectorRelation
    SETL message:(message + connectorRelation)
}

IF(endMessage != "")
{
    SETL message:(message + endMessage)
    SETL filePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\schema_graph.trig")
    CC "AdoScript" FWRITE file:(filePath) text:(message) binary:0
    #CC "AdoScript" SLEEP ms:100
    #Deletion of duplicate statements from the graph
    #SETL deletionScriptFilePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\trig_delete_duplicate_statements.py")
    #START ("python " + deletionScriptFilePath)
    #CC "AdoScript" SLEEP ms:500
    #SETL t2: (getTickCount())
    #SETL timesec: ((t2-t1)*0.001)
   # CC "AdoScript" INFOBOX ("The execution of the script took " + STR timesec+ " seconds.")
    #SETL readFilePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\schema_graph.trig")
    SETL metadataFilePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\generated_file_type.txt")
    CC "AdoScript" FWRITE file:(metadataFilePath) text:("schema\ntrig") binary:0
    #CC "AdoScript" FREAD file:(filePath)
    CC "AdoScript" VIEWBOX text:(message)
}
ELSE
{
    SETL filePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\schema_graph.ttl")
    CC "AdoScript" FWRITE file:(filePath) text:(message) binary:0
    #CC "AdoScript" SLEEP ms:100
    #Deletion of duplicate statements from the graph
    #SETL deletionScriptFilePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\delete_duplicate_statements_schema.py")
    #START ("python " + deletionScriptFilePath)
    #CC "AdoScript" SLEEP ms:500
    #SETL t2: (getTickCount())
    #SETL timesec: ((t2-t1)*0.001)
    #CC "AdoScript" INFOBOX ("The execution of the script took " + STR timesec+ " seconds.")
    SETL readFilePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\schema_graph.ttl")
    SETL metadataFilePath:("D:\\Andrei\\ModellingTools\\Graph_Modelling_Tool\\Scripts\\generated_file_type.txt")
    CC "AdoScript" FWRITE file:(metadataFilePath) text:("schema\nturtle") binary:0
    #CC "AdoScript" FREAD file:(filePath)
    CC "AdoScript" VIEWBOX text:(message)
}