        {
            IF(appendUri = 1)
            {
                SETL propertyAttrs:(propertyAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
            ELSE
            {
                SETL propertyAttrs:(propertyAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + endRow)
            }
        }
        IF(datatypeValue = "URI" AND userDefinedDatatypeValue = "")
        {
            IF(appendUri = 1)
            {
                SETL propertyAttrs:(propertyAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
            ELSE
            {
                SETL propertyAttrs:(propertyAttrs + prefixValue + attributeLocalIdentifierValue + " " + value + endRow)
            }
        }
        IF (datatypeValue != "URI" AND datatypeValue != "-" AND datatypeValue != "[" AND datatypeValue != "]" AND datatypeValue != "(" AND datatypeValue != ")")
        {
            IF(appendUri = 1)
            {
                SETL propertyAttrs:(propertyAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
            ELSE
            {
                SETL propertyAttrs:(propertyAttrs + prefixValue + attributeLocalIdentifierValue + " " + "\"" + value + "\"" + "^^" + datatypeValue + endRow)
            }
            #}
        }
        IF(datatypeValue = "[")
        {
            SETL openAnonymousNode:(1)
            SETL endRow:("; ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL propertyAttrs:(propertyAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "[")
            }
        }
        IF(datatypeValue = "]")
        {
            SETL openAnonymousNode:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL propertyAttrs:(propertyAttrs + "]" + endRow)
        }
        IF(datatypeValue = "(")
        {
            SETL openList:(1)
            SETL endRow:(" ")
            SETL appendUri:(0)
            IF(prefixValue != "" AND attributeLocalIdentifierValue != "")
            {
                SETL propertyAttrs:(propertyAttrs + objUri + " " + prefixValue + attributeLocalIdentifierValue + " " + "(")
            }
        }
        IF(datatypeValue = ")")
        {
            SETL openList:(0)
            SETL endRow:(".\n")
            SETL appendUri:(1)
            SETL propertyAttrs:(propertyAttrs + ")" + endRow)
        }
    }
    SETL result:(propertyAttrs)           
}

