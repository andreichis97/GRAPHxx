#SETL t1: (getTickCount())
SETL pythonScriptFilePath:(graphxxScriptsDir + "\\jsonld_transformer.py")
SETL filePath:(graphxxScriptsDir + "\\jsonld_graph.json")
SETL python_executable_path:(graphxxScriptsDir + "\\.venv\\Scripts\\python.exe")
SYSTEM ("\"" + python_executable_path + "\" \"" + pythonScriptFilePath + "\"")
#CC "AdoScript" SLEEP ms:5000
CC "AdoScript" FREAD file:(filePath)
SETL fileContent:(text)
#SETL t2: (getTickCount())
#SETL timesec: ((t2-t1)*0.001)
#CC "AdoScript" INFOBOX ("The execution of the script took " + STR timesec+ " seconds.")
CC "AdoScript" VIEWBOX text:(fileContent)