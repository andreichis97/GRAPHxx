CC "Modeling" GET_ACT_MODEL
SETL actModelId: (modelid)

CC "Core" GET_ALL_CONNECTORS modelid:(actModelId)

FOR i in:(objids)
{
    CC "Core" GET_CLASS_ID relation objid:(VAL i)
    CC "Core" GET_CLASS_NAME classid:(classid)
    SETL connectorClassName:(classname)
    #CC "AdoScript" INFOBOX (connectorClassName)

    CC "Core" GET_CONNECTOR_ENDPOINTS objid:(VAL i)
    CC "Core" GET_CLASS_ID objid:(fromobjid)
    CC "Core" GET_CLASS_NAME classid:(classid)
    SETL fromObjClassName:(classname)
    #CC "AdoScript" INFOBOX (fromObjClassName)

    CC "Core" GET_CLASS_ID objid:(toobjid)
    CC "Core" GET_CLASS_NAME classid:(classid)
    SETL toObjClassName:(classname)
    #CC "AdoScript" INFOBOX (toObjClassName)

    IF(connectorClassName = "RelatedTo")
    {
        IF((fromObjClassName = "ThingIdentifier" AND toObjClassName = "DatatypeNode") OR (fromObjClassName = "ThingIdentifier" AND toObjClassName = "Property"))
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF((fromObjClassName = "HelperNode" AND toObjClassName = "DatatypeNode") OR (fromObjClassName = "HelperNode" AND toObjClassName = "Property"))
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF((fromObjClassName = "Data" AND toObjClassName = "ThingIdentifier") OR (fromObjClassName = "Data" AND toObjClassName = "HelperNode") OR (fromObjClassName = "Data" AND toObjClassName = "Data") OR (fromObjClassName = "Data" AND toObjClassName = "ThingType") OR (fromObjClassName = "Data" AND toObjClassName = "Container") OR (fromObjClassName = "Data" AND toObjClassName = "DatatypeNode") OR (fromObjClassName = "Data" AND toObjClassName = "Property"))
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "ThingType")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF((fromObjClassName = "Container" AND toObjClassName = "DatatypeNode") OR (fromObjClassName = "Container" AND toObjClassName = "Property"))
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "DatatypeNode")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "Property" AND (toObjClassName != "Property" AND toObjClassName != "ThingType"))
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
    }
    IF(connectorClassName = "IsOfType")
    {
        IF(fromObjClassName = "ThingIdentifier" AND toObjClassName != "ThingType")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "HelperNode" AND toObjClassName != "ThingType")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "Container" AND toObjClassName != "ThingType")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "Data" AND toObjClassName != "DatatypeNode")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        #IF(fromObjClassName = "ThingType" OR fromObjClassName = "DatatypeNode" OR fromObjClassName = "Property")
        #{
        #    CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
        #    CC "Modeling" DYE (VAL i) error-mark
        #}
    }
    IF(connectorClassName = "HasAttribute")
    {
        IF(fromObjClassName = "ThingIdentifier" AND toObjClassName != "Data")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "HelperNode" AND toObjClassName != "Data")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "Container" AND toObjClassName != "Data")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "Data" OR fromObjClassName = "ThingType" OR fromObjClassName = "DatatypeNode" OR fromObjClassName = "Property")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
    }
    IF(connectorClassName = "From")
    {
        IF(fromObjClassName = "Property" AND (toObjClassName != "DatatypeNode" AND toObjClassName != "ThingType"))
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName != "Property")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
    }
    IF(connectorClassName = "To")
    {
        IF(fromObjClassName = "Property" AND (toObjClassName != "DatatypeNode" AND toObjClassName != "ThingType"))
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName != "Property")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
    }
    IF(connectorClassName = "IsAKindOf")
    {
        IF(fromObjClassName = "Property" AND toObjClassName != "Property")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "ThingType" AND toObjClassName != "ThingType")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName != "ThingType" OR fromObjClassName != "Property")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
    }
    IF(connectorClassName = "IsTheSame")
    {
        IF(fromObjClassName = "ThingIdentifier" AND toObjClassName != "ThingIdentifier")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "Property" AND toObjClassName != "Property")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName = "ThingType" AND toObjClassName != "ThingType")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
        IF(fromObjClassName != "ThingIdentifier" OR fromObjClassName != "ThingType" OR fromObjClassName != "Property")
        {
            CC "Core" SET_ATTR_VAL objid:(VAL i) attrname:"Warning message" val:("Wrong use")
            CC "Modeling" DYE (VAL i) error-mark
        }
    }
}