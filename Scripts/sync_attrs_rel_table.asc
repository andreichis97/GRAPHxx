#Important to take into account what happens with Containers, connected through RelatedTo connectors
#Global ClassIds
CC "Core" GET_CLASS_ID classname:("ThingIdentifier")
SETL thingIdentifierClassId:(classid)
CC "Core" GET_CLASS_ID classname:("HelperNode")
SETL helperNodeClassId:(classid)
CC "Core" GET_CLASS_ID classname:("Data")
SETL dataNodeClassId:(classid)
CC "Core" GET_CLASS_ID classname:("ThingType")
SETL thingTypeClassId:(classid)
CC "Core" GET_CLASS_ID classname:("Container")
SETL containerClassId:(classid)
CC "Core" GET_CLASS_ID classname:("RelatedTo")
SETL relatedToClassId:(classid)
CC "Core" GET_CLASS_ID classname:("HasAttribute")
SETL hasAttributeClassId:(classid)
CC "Core" GET_CLASS_ID classname:("IsOfType")
SETL isOfTypeClassId:(classid)
CC "Core" GET_CLASS_ID classname:("IsTheSame")
SETL isTheSameClassId:(classid)

#Procedures
#Get already existing table attributes / relationships
SETL existingAttrs:(array(100, 5))
PROCEDURE global GET_EXISTING_TABLE_ATTRS modelId: integer objectId: integer attributeId: integer attributesRowCounter: reference
{
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(objectId) attrid:(attributeId)
    IF(rowids != "")
    {
        FOR i in:(rowids)
        {
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("Prefix")
            SETL rowPrefix:(val)
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("AttributeLocalIdentifier")
            SETL rowAttributeLocalIdentifier:(val)
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("Value")
            SETL rowValue:(val)
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("Datatype")
            SETL rowDataType:(val)
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("User-defined Datatype")
            SETL rowUserDefinedDataType:(val)
            SETL existingAttrs[attributesRowCounter, 0]:(rowPrefix)
            SETL existingAttrs[attributesRowCounter, 1]:(rowAttributeLocalIdentifier)
            SETL existingAttrs[attributesRowCounter, 2]:(rowValue)
            SETL existingAttrs[attributesRowCounter, 3]:(rowDataType)
            SETL existingAttrs[attributesRowCounter, 4]:(rowUserDefinedDataType)
            SETL attributesRowCounter:(attributesRowCounter + 1)
        }
        SETL attributesRowCounter:(attributesRowCounter-1)
        #CC "AdoScript" INFOBOX (STR attributesRowCounter)
        #CC "AdoScript" INFOBOX (existingAttrs[attributesRowCounter-1, 1])
    }
}

SETL existingRelationships:(array(100, 5))
PROCEDURE global INIT_TABLES
{
    FOR i from:(0) to:(99)
    {
        SETL existingRelationships[i, 0]:("")
        SETL existingRelationships[i, 1]:("")
        SETL existingRelationships[i, 2]:("")
        SETL existingRelationships[i, 3]:("")
        SETL existingRelationships[i, 4]:("")
        SETL existingAttrs[i, 0]:("")
        SETL existingAttrs[i, 1]:("")
        SETL existingAttrs[i, 2]:("")
        SETL existingAttrs[i, 3]:("")
        SETL existingAttrs[i, 4]:("")
    }
}

PROCEDURE global GET_EXISTING_RELATIONSHIPS modelId: integer objectId: integer relationshipsRowCounter: reference
{
    CC "Core" GET_CONNECTORS objid:(objectId) out
    IF(objids != "")
    {
        FOR i in:(objids)
        {
            CC "Core" GET_CLASS_ID objid:(VAL i)
            CC "Core" GET_CLASS_NAME classid:(classid)
            SETL connectorClassName:(classname)
            CC "Core" GET_CONNECTOR_ENDPOINTS objid:(VAL i)
            CC "Core" GET_CLASS_ID objid:(toobjid)
            CC "Core" GET_CLASS_NAME classid:(classid)
            SETL toObjClassName:(classname)
            IF(connectorClassName = "RelatedTo")
            {
                CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"URI"
                SETL toobjUri:(val)
                IF(val = "")
                {
                    CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"Local identifier"
                    SETL toobjUri:("_:" + val)
                }
                CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
                SETL connectorPrefix:(val)
                CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Local identifier"
                SETL connectorLocalIdentifier:(val)
                SETL existingRelationships[relationshipsRowCounter, 0]:(connectorPrefix)
                SETL existingRelationships[relationshipsRowCounter, 1]:(connectorLocalIdentifier)
                SETL existingRelationships[relationshipsRowCounter, 2]:(toobjUri)
                SETL existingRelationships[relationshipsRowCounter, 3]:("URI")
            }
            IF(connectorClassName = "HasAttribute")
            {
                CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"Value"
                SETL toobjValue:(val)
                CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"User-defined datatypes"
                SETL toobjUserDefinedDatatype:(val)
                IF(toobjUserDefinedDatatype = "")
                {
                    CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"Built-in data"
                    SETL toobjBuiltInData:(val)
                }
                CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
                SETL connectorPrefix:(val)
                CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Local identifier"
                SETL connectorLocalIdentifier:(val)
                SETL existingRelationships[relationshipsRowCounter, 0]:(connectorPrefix)
                SETL existingRelationships[relationshipsRowCounter, 1]:(connectorLocalIdentifier)
                SETL existingRelationships[relationshipsRowCounter, 2]:(toobjValue)
                SETL existingRelationships[relationshipsRowCounter, 3]:(toobjBuiltInData)
                SETL existingRelationships[relationshipsRowCounter, 4]:(toobjUserDefinedDatatype)
            }
            IF(connectorClassName = "IsOfType")
            {
                CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"URI"
                SETL toobjUri:(val)
                #IF(val = "")
                #{
                #    CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"Local identifier"
                #    SETL toobjUri:("_:" + val)
                #}
                CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
                SETL connectorPrefix:(val)
                CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Local identifier"
                SETL connectorLocalIdentifier:(val)
                SETL existingRelationships[relationshipsRowCounter, 0]:("")
                SETL existingRelationships[relationshipsRowCounter, 1]:("a")
                SETL existingRelationships[relationshipsRowCounter, 2]:(toobjUri)
                SETL existingRelationships[relationshipsRowCounter, 3]:("URI")
            }
            IF(connectorClassName = "IsTheSame")
            {
                CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"URI"
                SETL toobjUri:(val)
                IF(val = "")
                {
                    CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"Local identifier"
                    SETL toobjUri:("_:" + val)
                }
                CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
                SETL connectorPrefix:(val)
                CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Local identifier"
                SETL connectorLocalIdentifier:(val)
                SETL existingRelationships[relationshipsRowCounter, 0]:("owl:")
                SETL existingRelationships[relationshipsRowCounter, 1]:("sameAs")
                SETL existingRelationships[relationshipsRowCounter, 2]:(toobjUri)
                SETL existingRelationships[relationshipsRowCounter, 3]:("URI")
            }
            SETL relationshipsRowCounter:(relationshipsRowCounter + 1) #aici este corect
        }
        SETL relationshipsRowCounter:(relationshipsRowCounter - 1)
        #CC "AdoScript" INFOBOX (STR relationshipsRowCounter)
        #CC "AdoScript" INFOBOX (existingRelationships[relationshipsRowCounter, 3])
        #CC "AdoScript" VIEWBOX text:(
        #                    "table Prefix: " + existingRelationships[relationshipsRowCounter, 0] + "\n" +
        #                    "table local identifier: " + existingRelationships[relationshipsRowCounter, 1] + "\n" +
        #                    "table value: " + existingRelationships[relationshipsRowCounter, 2] + "\n" +
        #                    "table data type: " + existingRelationships[relationshipsRowCounter, 3] + "\n" +
        #                    "table user defined data type: " + existingRelationships[relationshipsRowCounter, 4] + "\n")
    }
}

#Helper functions to check if certain attributes exist in tables or not
PROCEDURE global CHECK_EXISTING_TABLE_ATTRIBUTES rowPrefix: string rowAttributeLocalIdentifier: string rowValue: string rowDataType: string rowUserDefinedDataType: string exists: reference
{
    SETL exists:(0)
    #CC "AdoScript" VIEWBOX text:("attributesRowCounter: " + STR attributesRowCounter + "\n")
    FOR i from:(0) to:(attributesRowCounter)
    {
        #CC "AdoScript" VIEWBOX text:("rowPrefix: " + rowPrefix + "\n" + 
        #                            "rowAttributeLocalIdentifier: " + rowAttributeLocalIdentifier + "\n" + 
        #                            "rowValue: " + rowValue + "\n" + "rowDataType: " + rowDataType + "\n" +
        #                            "rowUserDefinedDataType: " + rowUserDefinedDataType + "\n" +
        #                            "\n" + "\n" +
        #                            "table row: " + STR i + "\n" +
        #                            "table Prefix: " + existingAttrs[i, 0] + "\n" +
        #                            "table local identifier: " + existingAttrs[i, 1] + "\n" +
        #                            "table value: " + existingAttrs[i, 2] + "\n" +
        #                            "table data type: " + existingAttrs[i, 3] + "\n" +
        #                            "table user defined data type: " + existingAttrs[i, 4] + "\n")

        IF(rowPrefix = existingAttrs[i, 0] AND rowAttributeLocalIdentifier = existingAttrs[i, 1] AND rowValue = existingAttrs[i, 2] AND rowDataType = existingAttrs[i, 3] AND rowUserDefinedDataType = existingAttrs[i, 4])
        {
            SETL exists:(1)
            BREAK
        }
    }
}

PROCEDURE global CHECK_EXISTING_OUTGOING_RELATIONSHIPS rowPrefix: string rowAttributeLocalIdentifier: string rowValue: string rowDataType: string rowUserDefinedDataType: string exists: reference
{
    SETL exists:(0)
    #CC "AdoScript" VIEWBOX text:("relationshipsRowCounter: " + STR relationshipsRowCounter + "\n")
    FOR i from:(0) to:(relationshipsRowCounter)
    {
        #CC "AdoScript" VIEWBOX text:("rowPrefix: " + rowPrefix + "\n" + 
        #                            "rowAttributeLocalIdentifier: " + rowAttributeLocalIdentifier + "\n" + 
        #                            "rowValue: " + rowValue + "\n" + "rowDataType: " + rowDataType + "\n" +
        #                            "rowUserDefinedDataType: " + rowUserDefinedDataType + "\n" +
        #                            "\n" + "\n" +
        #                            "table row: " + STR i + "\n" +
        #                            "table Prefix: " + existingRelationships[i, 0] + "\n" +
        #                            "table local identifier: " + existingRelationships[i, 1] + "\n" +
        #                            "table value: " + existingRelationships[i, 2] + "\n" +
        #                            "table data type: " + existingRelationships[i, 3] + "\n" +
        #                            "table user defined data type: " + existingRelationships[i, 4] + "\n")

        IF(rowPrefix = existingRelationships[i, 0] AND rowAttributeLocalIdentifier = existingRelationships[i, 1] AND rowValue = existingRelationships[i, 2] AND rowDataType = existingRelationships[i, 3] AND rowUserDefinedDataType = existingRelationships[i, 4])
        {
            SETL exists:(1)
            #CC "AdoScript" INFOBOX(exists)
            BREAK
        }
    }
}

#Get relationships with ThingIdentifiers
PROCEDURE global GET_RELATEDTO_RELATIONSHIPS modelId: integer objectId: integer attributeId: integer
{
    CC "Core" GET_CONNECTORS objid:(objectId) out
    FOR i in:(objids)
    {
        CC "Core" GET_CLASS_ID objid:(VAL i)
        CC "Core" GET_CLASS_NAME classid:(classid)
        IF(classname = "RelatedTo")
        {
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
            SETL connectorPrefix:(val)
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Local identifier"
            SETL connectorLocalIdentifier:(val)
            CC "Core" GET_CONNECTOR_ENDPOINTS objid:(VAL i)
            CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"URI"
            SETL objUri:(val)
            IF(val = "")
            {
                CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"Local identifier"
                SETL objUri:("_:" + val)
            }
            SETL existsInTable:(0)
            CHECK_EXISTING_TABLE_ATTRIBUTES rowPrefix:(connectorPrefix) rowAttributeLocalIdentifier:(connectorLocalIdentifier) rowValue:(objUri) rowDataType:("URI") rowUserDefinedDataType:("") exists:existsInTable
            #CC "AdoScript" INFOBOX(existsInTable)
            IF(existsInTable = 0)
            {
                CC "Core" ADD_REC_ROW objid:(objectId) attrid:(attributeId)
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Prefix" val:(connectorPrefix)
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"AttributeLocalIdentifier" val:(connectorLocalIdentifier)
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Value" val:(objUri)
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Datatype" val:("URI")
            }
        }
    }
}

#Get relationships with HasAttribute
PROCEDURE global GET_HASATTRIBUTE_RELATIONSHIPS modelId: integer objectId: integer attributeId: integer
{
    CC "Core" GET_CONNECTORS objid:(objectId) out
    FOR i in:(objids)
    {
        CC "Core" GET_CLASS_ID objid:(VAL i)
        CC "Core" GET_CLASS_NAME classid:(classid)
        IF(classname = "HasAttribute")
        {
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Prefix"
            SETL connectorPrefix:(val)
            CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:"Local identifier"
            SETL connectorLocalIdentifier:(val)
            CC "Core" GET_CONNECTOR_ENDPOINTS objid:(VAL i)
            CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"Value"
            SETL attrValue:(val)
            CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"User-defined datatypes"
            IF(val != "")
            {
                CC "Core" GET_INTERREF objid:(toobjid) attrname:"User-defined datatypes"
                CC "Core" GET_ATTR_VAL objid:(tobjid) attrname:"URI"
                SETL uriVal:(val)
                SETL existsInTable:(0)

                CHECK_EXISTING_TABLE_ATTRIBUTES rowPrefix:(connectorPrefix) rowAttributeLocalIdentifier:(connectorLocalIdentifier) rowValue:(attrValue) rowDataType:("-") rowUserDefinedDataType:(uriVal) exists:existsInTable
                IF(existsInTable = 0)
                {
                    CC "Core" ADD_REC_ROW objid:(objectId) attrid:(attributeId)
                    CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Prefix" val:(connectorPrefix)
                    CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"AttributeLocalIdentifier" val:(connectorLocalIdentifier)
                    CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Value" val:(attrValue)
                    CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Datatype" val:("-")
                    CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"User-defined Datatype" val:(uriVal)
                }
            }
            ELSE 
            {
                CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"Built-in data"
                SETL uriVal:(val)
                SETL existsInTable:(0)
                CHECK_EXISTING_TABLE_ATTRIBUTES rowPrefix:(connectorPrefix) rowAttributeLocalIdentifier:(connectorLocalIdentifier) rowValue:(attrValue) rowDataType:(uriVal) rowUserDefinedDataType:("") exists:existsInTable
                IF(existsInTable = 0)
                {
                    CC "Core" ADD_REC_ROW objid:(objectId) attrid:(attributeId)
                    CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Prefix" val:(connectorPrefix)
                    CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"AttributeLocalIdentifier" val:(connectorLocalIdentifier)
                    CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Value" val:(attrValue)
                    CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Datatype" val:(uriVal)
                }
            }
        }
    }
}

PROCEDURE global GET_ISOFTYPE_RELATIONSHIPS modelId: integer objectId: integer attributeId: integer
{
    CC "Core" GET_CONNECTORS objid:(objectId) out
    FOR i in:(objids)
    {
        CC "Core" GET_CLASS_ID objid:(VAL i)
        CC "Core" GET_CLASS_NAME classid:(classid)
        IF(classname = "IsOfType")
        {
            CC "Core" GET_CONNECTOR_ENDPOINTS objid:(VAL i)
            CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"URI"
            SETL objUri:(val)
            SETL existsInTable:(0)
            CHECK_EXISTING_TABLE_ATTRIBUTES rowPrefix:("") rowAttributeLocalIdentifier:("a") rowValue:(objUri) rowDataType:("URI") rowUserDefinedDataType:("") exists:existsInTable
            IF(existsInTable = 0)
            {
                CC "Core" ADD_REC_ROW objid:(objectId) attrid:(attributeId)
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"AttributeLocalIdentifier" val:("a")
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Value" val:(objUri)
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Datatype" val:("URI")
            }
        }
    }
}

PROCEDURE global GET_ISTHESAME_RELATIONSHIPS modelId: integer objectId: integer attributeId: integer
{
    CC "Core" GET_CONNECTORS objid:(objectId) out
    FOR i in:(objids)
    {
        CC "Core" GET_CLASS_ID objid:(VAL i)
        CC "Core" GET_CLASS_NAME classid:(classid)
        IF(classname = "IsTheSame")
        {
            CC "Core" GET_CONNECTOR_ENDPOINTS objid:(VAL i)
            CC "Core" GET_ATTR_VAL objid:(toobjid) attrname:"URI"
            SETL objUri:(val)
            SETL existsInTable:(0)
            CHECK_EXISTING_TABLE_ATTRIBUTES rowPrefix:("owl:") rowAttributeLocalIdentifier:("sameAs") rowValue:(objUri) rowDataType:("URI") rowUserDefinedDataType:("") exists:existsInTable
            IF(existsInTable = 0)
            {
                CC "Core" ADD_REC_ROW objid:(objectId) attrid:(attributeId)
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Prefix" val:("owl:")
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"AttributeLocalIdentifier" val:("sameAs")
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Value" val:(objUri)
                CC "Core" SET_ATTR_VAL objid:(rowid) attrname:"Datatype" val:("URI")
            }
        }
    }
}

PROCEDURE global SET_OUTGOING_RELATIONSHIPS modelId: integer objectId: integer attributeId: integer
{
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(objectId) attrid:(attributeId)
    SETL posMultiplier:(0)
    CC "Core" GET_ATTR_VAL objid:(selectedObj) attrname:("Position")
    SETL selectedObjPosition:(val)
    FOR i in:(rowids)
    {
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("Prefix")
        SETL rowPrefix:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("AttributeLocalIdentifier")
        SETL rowAttributeLocalIdentifier:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("Value")
        SETL rowValue:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("Datatype")
        SETL rowDataType:(val)
        CC "Core" GET_ATTR_VAL objid:(VAL i) attrname:("User-defined Datatype")
        SETL rowUserDefinedDataType:(val)
        SETL rawX:(token(selectedObjPosition, 1, " "))
        SETL rawX:(replall(rawX, "x:", ""))
        SETL xPoz:(replall(rawX, "cm", ""))
        SETL xPoz:(VAL xPoz)
        SETL xPoz:(xPoz + 3)
        SETL rawY:(token(selectedObjPosition, 2, " "))
        SETL rawY:(replall(rawY, "y:", ""))
        SETL yPoz:(replall(rawY, "cm", ""))
        SETL yPoz:(VAL yPoz)
        SETL yPoz:(yPoz + 1.5 * posMultiplier)
        SETL rawW:(token(selectedObjPosition, 3, " "))
        SETL rawW:(replall(rawW, "w:", ""))
        SETL wPoz:(replall(rawW, "cm", ""))
        SETL wPoz:(VAL wPoz)
        SETL rawH:(token(selectedObjPosition, 4, " "))
        SETL rawH:(replall(rawH, "h:", ""))
        SETL hPoz:(replall(rawH, "cm", ""))
        SETL hPoz:(VAL hPoz)
        SETL newObjPos:("NODE x:" + STR xPoz + "cm y:" + STR yPoz + "cm w:" + STR wPoz + "cm h:" + STR hPoz + "cm")
        #CC "AdoScript" INFOBOX (STR newObjPos)
        IF(rowDataType = "URI")
        {
            SETL helperNodeFlag:(0)
            SETL thingTypeFlag:(0)
            SETL sameAsFlag:(0)
            SETL objPrefix:(token(rowValue, 0, ":"))
            SETL objLocalIdentifier:(token(rowValue, 1, ":"))
            #CC "AdoScript" INFOBOX (objPrefix)
            IF(objPrefix = "")
            {
                SETL objPrefix:(":")
            }
            ELSIF(objPrefix = "_")
            {
                SETL helperNodeFlag:(1)
                SETL objPrefix:("_:")
            }
            ELSE
            {
                SETL objPrefix:(objPrefix + ":")
            }

            IF((rowAttributeLocalIdentifier = "a" AND rowPrefix = "") OR (rowAttributeLocalIdentifier = "type" AND rowPrefix = "rdf:"))
            {
                SETL thingTypeFlag:(1)
            }

            IF((rowAttributeLocalIdentifier = "sameAs" AND rowPrefix = "owl:"))
            {
                SETL sameAsFlag:(1)
            }

            IF(helperNodeFlag = 0 AND thingTypeFlag = 0 AND sameAsFlag = 0)
            {
                SETL existsRelation:(0)
                CHECK_EXISTING_OUTGOING_RELATIONSHIPS rowPrefix:(rowPrefix) rowAttributeLocalIdentifier:(rowAttributeLocalIdentifier) rowValue:(objPrefix+objLocalIdentifier) rowDataType:("URI") rowUserDefinedDataType:("") exists:existsRelation
                IF(existsRelation = 0)
                {
                    CC "Core" CREATE_OBJ modelid:(modelId) classid:(thingIdentifierClassId)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Position" val:(newObjPos)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Prefix" val:(objPrefix)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Local identifier" val:(objLocalIdentifier)
                    CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(objectId) toobjid:(objid) classid:(relatedToClassId)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Prefix" val:(rowPrefix)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Local identifier" val:(rowAttributeLocalIdentifier)
                    SETL posMultiplier:(posMultiplier + 1)
                }
            }
            ELSIF(helperNodeFlag = 1 AND thingTypeFlag = 0 AND sameAsFlag = 0)
            {
                SETL existsRelation:(0)
                CHECK_EXISTING_OUTGOING_RELATIONSHIPS rowPrefix:(rowPrefix) rowAttributeLocalIdentifier:(rowAttributeLocalIdentifier) rowValue:(objLocalIdentifier) rowDataType:("URI") rowUserDefinedDataType:("") exists:existsRelation
                IF(existsRelation = 0)
                {
                    CC "Core" CREATE_OBJ modelid:(modelId) classid:(helperNodeClassId)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Position" val:(newObjPos)
                    #CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Prefix" val:(objPrefix)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Local identifier" val:(objLocalIdentifier)
                    CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(objectId) toobjid:(objid) classid:(relatedToClassId)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Prefix" val:(rowPrefix)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Local identifier" val:(rowAttributeLocalIdentifier)
                    SETL posMultiplier:(posMultiplier + 1)
                }
            }
            ELSIF(helperNodeFlag = 0 AND thingTypeFlag = 1 AND sameAsFlag = 0)
            {
                SETL existsRelation:(0)
                CHECK_EXISTING_OUTGOING_RELATIONSHIPS rowPrefix:("") rowAttributeLocalIdentifier:("a") rowValue:(objPrefix+objLocalIdentifier) rowDataType:("URI") rowUserDefinedDataType:("") exists:existsRelation
                IF(existsRelation = 0)
                {
                    CC "Core" CREATE_OBJ modelid:(modelId) classid:(thingTypeClassId)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Position" val:(newObjPos)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Prefix" val:(objPrefix)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Local identifier" val:(objLocalIdentifier)
                    CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(objectId) toobjid:(objid) classid:(isOfTypeClassId)
                    SETL posMultiplier:(posMultiplier + 1)
                }
            }
            ELSIF(helperNodeFlag = 0 AND thingTypeFlag = 0 AND sameAsFlag = 1)
            {
                SETL existsRelation:(0)
                CHECK_EXISTING_OUTGOING_RELATIONSHIPS rowPrefix:("owl:") rowAttributeLocalIdentifier:("sameAs") rowValue:(objPrefix+objLocalIdentifier) rowDataType:("URI") rowUserDefinedDataType:("") exists:existsRelation
                IF(existsRelation = 0)
                {
                    CC "Core" CREATE_OBJ modelid:(modelId) classid:(thingIdentifierClassId)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Position" val:(newObjPos)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Prefix" val:(objPrefix)
                    CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Local identifier" val:(objLocalIdentifier)
                    CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(objectId) toobjid:(objid) classid:(isTheSameClassId)
                    SETL posMultiplier:(posMultiplier + 1)
                }
            }
        }
        IF (rowDataType = "[" OR rowDataType = "]" OR rowDataType = "(" OR rowDataType = ")")
        {

        }
        IF(rowDataType != "[" AND rowDataType != "]" AND rowDataType != "(" AND rowDataType != ")" AND rowDataType != "URI")
        {
            SETL existsRelation:(0)
            CHECK_EXISTING_OUTGOING_RELATIONSHIPS rowPrefix:(rowPrefix) rowAttributeLocalIdentifier:(rowAttributeLocalIdentifier) rowValue:(rowValue) rowDataType:(rowDataType) rowUserDefinedDataType:("") exists:existsRelation
            IF(existsRelation = 0)
            {
                CC "Core" CREATE_OBJ modelid:(modelId) classid:(dataNodeClassId)
                CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Position" val:(newObjPos)
                CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Value" val:(rowValue)
                CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Datatype" val:(rowDataType)
                CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(objectId) toobjid:(objid) classid:(hasAttributeClassId)
                CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Prefix" val:(rowPrefix)
                CC "Core" SET_ATTR_VAL objid:(objid) attrname:"Local identifier" val:(rowAttributeLocalIdentifier)
                SETL posMultiplier:(posMultiplier + 1)
            }
        }
    }
}

############## Main ##############
CC "Modeling" GET_ACT_MODEL
SETL actModelId: (modelid)

CC "Modeling" GET_SELECTED  modelid:(actModelId)
SETL selectedObj: (VAL token(objids, 0, " "))

CC "Core" GET_CLASS_ID objid:(selectedObj)
CC "Core" GET_CLASS_NAME classid:(classid)
CC "Core" GET_ATTR_ID classid:(classid) attrname:"Attributes"
SETL attributeIdVal:(attrid)

SETL attributesRowCounter:(0)
SETL relationshipsRowCounter:(0)
INIT_TABLES
GET_EXISTING_TABLE_ATTRS modelId:(actModelId) objectId:(selectedObj) attributeId:(attributeIdVal) attributesRowCounter:attributesRowCounter
GET_EXISTING_RELATIONSHIPS modelId:(actModelId) objectId:(selectedObj) relationshipsRowCounter:relationshipsRowCounter
GET_RELATEDTO_RELATIONSHIPS modelId:(actModelId) objectId:(selectedObj) attributeId:(attributeIdVal)
GET_HASATTRIBUTE_RELATIONSHIPS modelId:(actModelId) objectId:(selectedObj) attributeId:(attributeIdVal)
GET_ISOFTYPE_RELATIONSHIPS modelId:(actModelId) objectId:(selectedObj) attributeId:(attributeIdVal)
GET_ISTHESAME_RELATIONSHIPS modelId:(actModelId) objectId:(selectedObj) attributeId:(attributeIdVal)
SET_OUTGOING_RELATIONSHIPS modelId:(actModelId) objectId:(selectedObj) attributeId:(attributeIdVal)