#==============================================================================
# sync_attrs_rel_table_v3.asc
#
# Two-way synchronisation between the "Attributes" table of the selected element
# and its OUTGOING connectors on the canvas:
#   1. table rows that have no matching connector -> nodes and connectors are
#      created on the canvas (a new node is ALWAYS created)
#   2. connectors that have no matching table row -> rows are added to the table
#
# Simple rows / connectors:
#   RelatedTo    <-> row with Datatype "URI"
#   IsOfType     <-> row "a" / "rdf:type" with Datatype "URI"   (target ThingType)
#   IsTheSame    <-> row "owl:sameAs" with Datatype "URI"
#   HasAttribute <-> row with a built-in Datatype or a User-defined Datatype
#
# Blank-node groups (one level, no nesting):
#   :worksFor          [          <- predicate row, Datatype "["
#   schema:legalName   OCorp  xsd:string
#   :foundedIn         2025   xsd:integer
#   :supplierOf        ACorp  URI
#                      ]          <- end of the group, Datatype "]"
#   <-> source --RelatedTo(:worksFor)--> HelperNode (empty local identifier)
#       HelperNode --HasAttribute / RelatedTo / IsOfType / IsTheSame--> ...
#   Every HelperNode reached from the source through a RelatedTo connector is
#   treated as a group. A table group and a canvas blank node with the same
#   predicate are paired (the pair sharing most inner relations wins) and their
#   inner relations are merged in both directions.
#   Old-style rows ":p _:b1 URI" are still accepted.
#
# Rows between "(" and ")" (RDF collections / lists) are ignored (not synchronised).
#
# Matching is done on a normalised key built from:
#   predicate (Prefix + AttributeLocalIdentifier, "rdf:type"/"a" unified)
#   kind      (R = resource, L = literal)
#   value     (resources: Prefix + Local identifier of the target node, falling
#              back to its URI attribute; blank nodes as "_:id")
#   datatype  (built-in datatype, or "^^" + identifier of the user-defined one)
#
# All procedures receive what they need through parameters and only use their
# own (prefixed) local variables, so they do not depend on the caller's scope.
#==============================================================================


#------------------------------------------------------------------------------
# Generic helpers
#------------------------------------------------------------------------------

# Reads an attribute value; returns "" if the attribute does not exist
PROCEDURE global SYNCTBL_GET_ATTR objId: integer attrName: string result: reference
{
    CC "Core" GET_ATTR_VAL objid:(objId) attrname:(attrName)
    IF(ecode = 0)
    {
        SETL result:(val)
    }
    ELSE
    {
        SETL result:("")
    }
}

# result = 1 if str starts with startStr, otherwise 0
PROCEDURE global SYNCTBL_STARTS_WITH str: string startStr: string result: reference
{
    SETL result:(0)
    IF((LEN str) >= (LEN startStr))
    {
        IF(copy(str, 0, (LEN startStr)) = startStr)
        {
            SETL result:(1)
        }
    }
}

# Removes leading / trailing spaces, tabs and line breaks
PROCEDURE global SYNCTBL_TRIM str: string result: reference
{
    SETL tmStr:(str)
    SETL tmGo:(1)
    WHILE(tmGo = 1)
    {
        IF((LEN tmStr) = 0)
        {
            SETL tmGo:(0)
        }
        ELSE
        {
            SETL tmCh:(copy(tmStr, 0, 1))
            IF(tmCh = " " OR tmCh = "\t" OR tmCh = "\r" OR tmCh = "\n")
            {
                SETL tmStr:(copy(tmStr, 1, (LEN tmStr) - 1))
            }
            ELSE
            {
                SETL tmGo:(0)
            }
        }
    }
    SETL tmGo:(1)
    WHILE(tmGo = 1)
    {
        IF((LEN tmStr) = 0)
        {
            SETL tmGo:(0)
        }
        ELSE
        {
            SETL tmCh:(copy(tmStr, (LEN tmStr) - 1, 1))
            IF(tmCh = " " OR tmCh = "\t" OR tmCh = "\r" OR tmCh = "\n")
            {
                SETL tmStr:(copy(tmStr, 0, (LEN tmStr) - 1))
            }
            ELSE
            {
                SETL tmGo:(0)
            }
        }
    }
    SETL result:(tmStr)
}

# Normalises a resource identifier so that table values and canvas values are comparable
#   ""          -> ""
#   "<http..>"  -> unchanged (full IRI)
#   "Mike"      -> ":Mike"   (no prefix = default prefix)
#   ":Mike"     -> unchanged
PROCEDURE global SYNCTBL_NORMALIZE_RESOURCE value: string result: reference
{
    SETL nrIsIri:(0)
    IF(value = "")
    {
        SETL result:("")
    }
    ELSE
    {
        SYNCTBL_STARTS_WITH str:(value) startStr:("<") result:nrIsIri
        IF(nrIsIri = 1)
        {
            SETL result:(value)
        }
        ELSIF(search(value, ":", 0) < 0)
        {
            SETL result:(":" + value)
        }
        ELSE
        {
            SETL result:(value)
        }
    }
}

# Normalises a predicate: "a", ":a" and "rdf:type" are all mapped to "a"
PROCEDURE global SYNCTBL_NORMALIZE_PREDICATE predPrefix: string predLocal: string result: reference
{
    IF(predLocal = "a" AND (predPrefix = "" OR predPrefix = ":"))
    {
        SETL result:("a")
    }
    ELSIF(predPrefix + predLocal = "rdf:type")
    {
        SETL result:("a")
    }
    ELSE
    {
        SETL result:(predPrefix + predLocal)
    }
}

# Identifier of a canvas node, comparable with the table "Value" column
#   HelperNode -> "_:" + Local identifier ("" if the local identifier is empty)
#   others     -> Prefix + Local identifier (URI attribute as fallback)
PROCEDURE global SYNCTBL_GET_NODE_IDENT objId: integer result: reference
{
    SETL niPrefix:("")
    SETL niLocal:("")
    SETL niUri:("")
    SETL niNorm:("")
    SETL niFlag:(0)

    CC "Core" GET_CLASS_ID objid:(objId)
    CC "Core" GET_CLASS_NAME classid:(classid)
    SETL niClass:(classname)

    SYNCTBL_GET_ATTR objId:(objId) attrName:("Local identifier") result:niLocal
    SYNCTBL_TRIM str:(niLocal) result:niLocal
    IF(niClass = "HelperNode")
    {
        SYNCTBL_STARTS_WITH str:(niLocal) startStr:("_:") result:niFlag
        IF(niLocal = "")
        {
            SETL result:("")
        }
        ELSIF(niFlag = 1)
        {
            SETL result:(niLocal)
        }
        ELSE
        {
            SETL result:("_:" + niLocal)
        }
    }
    ELSE
    {
        SYNCTBL_GET_ATTR objId:(objId) attrName:("Prefix") result:niPrefix
        SYNCTBL_TRIM str:(niPrefix) result:niPrefix
        IF(niLocal != "")
        {
            # make sure the prefix ends with ":" (e.g. "ex" -> "ex:")
            IF(niPrefix != "")
            {
                IF(copy(niPrefix, (LEN niPrefix) - 1, 1) != ":")
                {
                    SETL niPrefix:(niPrefix + ":")
                }
            }
            SYNCTBL_NORMALIZE_RESOURCE value:(niPrefix + niLocal) result:niNorm
        }
        ELSE
        {
            SYNCTBL_GET_ATTR objId:(objId) attrName:("URI") result:niUri
            SYNCTBL_TRIM str:(niUri) result:niUri
            SYNCTBL_NORMALIZE_RESOURCE value:(niUri) result:niNorm
        }
        SETL result:(niNorm)
    }
}

# Builds the comparison key of a relation; result = "" if the row must be ignored
PROCEDURE global SYNCTBL_MAKE_KEY rowPrefix: string rowLocal: string rowValue: string rowDt: string rowUdt: string result: reference
{
    SETL mkPred:("")
    SETL mkVal:("")
    SETL mkUdt:("")
    SETL mkPrefix:("")
    SETL mkLocal:("")
    SETL mkValue:("")
    SETL mkDt:("")
    SETL mkUdtRaw:("")
    SETL result:("")

    # whitespace must not make two otherwise equal relations different
    SYNCTBL_TRIM str:(rowPrefix) result:mkPrefix
    SYNCTBL_TRIM str:(rowLocal) result:mkLocal
    SYNCTBL_TRIM str:(rowValue) result:mkValue
    SYNCTBL_TRIM str:(rowDt) result:mkDt
    SYNCTBL_TRIM str:(rowUdt) result:mkUdtRaw

    IF(mkLocal != "" AND mkDt != "[" AND mkDt != "]" AND mkDt != "(" AND mkDt != ")")
    {
        SYNCTBL_NORMALIZE_PREDICATE predPrefix:(mkPrefix) predLocal:(mkLocal) result:mkPred
        IF(mkUdtRaw != "")
        {
            # literal with user-defined datatype (Datatype column is ignored, usually "-")
            SYNCTBL_NORMALIZE_RESOURCE value:(mkUdtRaw) result:mkUdt
            IF(mkValue != "")
            {
                SETL result:(mkPred + "|L|" + mkValue + "|^^" + mkUdt)
            }
        }
        ELSIF(mkDt = "URI")
        {
            # resource
            SYNCTBL_NORMALIZE_RESOURCE value:(mkValue) result:mkVal
            IF(mkVal != "")
            {
                SETL result:(mkPred + "|R|" + mkVal + "|")
            }
        }
        ELSE
        {
            # literal with built-in datatype
            # (RDF 1.1: a literal without datatype is an xsd:string literal)
            IF(mkDt = "")
            {
                SETL mkDt:("xsd:string")
            }
            IF(mkValue != "")
            {
                SETL result:(mkPred + "|L|" + mkValue + "|" + mkDt)
            }
        }
    }
}

# result = 1 if key is part of keySet (keySet format: "\nkey1\nkey2\n")
PROCEDURE global SYNCTBL_KEY_EXISTS keySet: string key: string result: reference
{
    IF(search(keySet, "\n" + key + "\n", 0) >= 0)
    {
        SETL result:(1)
    }
    ELSE
    {
        SETL result:(0)
    }
}

# Number of keys of keySetA that are also part of keySetB
PROCEDURE global SYNCTBL_COUNT_COMMON keySetA: string keySetB: string result: reference
{
    SETL ccCount:(0)
    SETL ccExists:(0)
    FOR ccKey in:(keySetA) sep:("\n")
    {
        IF(ccKey != "")
        {
            SYNCTBL_KEY_EXISTS keySet:(keySetB) key:(ccKey) result:ccExists
            IF(ccExists = 1)
            {
                SETL ccCount:(ccCount + 1)
            }
        }
    }
    SETL result:(ccCount)
}


#------------------------------------------------------------------------------
# Table access
#------------------------------------------------------------------------------

PROCEDURE global SYNCTBL_READ_ROW rowId: integer rPrefix: reference rLocal: reference rValue: reference rDt: reference rUdt: reference
{
    SETL rrTmp:("")
    SYNCTBL_GET_ATTR objId:(rowId) attrName:("Prefix") result:rrTmp
    SETL rPrefix:(rrTmp)
    SYNCTBL_GET_ATTR objId:(rowId) attrName:("AttributeLocalIdentifier") result:rrTmp
    SETL rLocal:(rrTmp)
    SYNCTBL_GET_ATTR objId:(rowId) attrName:("Value") result:rrTmp
    SETL rValue:(rrTmp)
    SYNCTBL_GET_ATTR objId:(rowId) attrName:("Datatype") result:rrTmp
    SETL rDt:(rrTmp)
    SYNCTBL_GET_ATTR objId:(rowId) attrName:("User-defined Datatype") result:rrTmp
    SETL rUdt:(rrTmp)
}

# Writes the five synchronised columns of an existing row
PROCEDURE global SYNCTBL_WRITE_ROW rowId: integer rowPrefix: string rowLocal: string rowValue: string rowDt: string rowUdt: string
{
    CC "Core" SET_ATTR_VAL objid:(rowId) attrname:("Prefix") val:(rowPrefix)
    CC "Core" SET_ATTR_VAL objid:(rowId) attrname:("AttributeLocalIdentifier") val:(rowLocal)
    CC "Core" SET_ATTR_VAL objid:(rowId) attrname:("Value") val:(rowValue)
    CC "Core" SET_ATTR_VAL objid:(rowId) attrname:("Datatype") val:(rowDt)
    CC "Core" SET_ATTR_VAL objid:(rowId) attrname:("User-defined Datatype") val:(rowUdt)
}

# Appends a row at the end of the table
PROCEDURE global SYNCTBL_ADD_TABLE_ROW objId: integer attrId: integer rowPrefix: string rowLocal: string rowValue: string rowDt: string rowUdt: string
{
    CC "Core" ADD_REC_ROW objid:(objId) attrid:(attrId)
    SETL atRowId:(rowid)
    CC "Core" SET_ATTR_VAL objid:(atRowId) attrname:("Prefix") val:(rowPrefix)
    CC "Core" SET_ATTR_VAL objid:(atRowId) attrname:("AttributeLocalIdentifier") val:(rowLocal)
    CC "Core" SET_ATTR_VAL objid:(atRowId) attrname:("Value") val:(rowValue)
    CC "Core" SET_ATTR_VAL objid:(atRowId) attrname:("Datatype") val:(rowDt)
    IF(rowUdt != "")
    {
        CC "Core" SET_ATTR_VAL objid:(atRowId) attrname:("User-defined Datatype") val:(rowUdt)
    }
}

# Inserts a row at the given (0-based) position: a row is appended and the
# contents of the rows from "position" on are shifted one row down
PROCEDURE global SYNCTBL_INSERT_ROW objId: integer attrId: integer position: integer rowPrefix: string rowLocal: string rowValue: string rowDt: string rowUdt: string
{
    SETL irPrefix:("")
    SETL irLocal:("")
    SETL irValue:("")
    SETL irDt:("")
    SETL irUdt:("")

    CC "Core" ADD_REC_ROW objid:(objId) attrid:(attrId)
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(objId) attrid:(attrId)
    SETL irIds:(rowids)
    SETL irCount:(0)
    FOR irId in:(irIds)
    {
        SETL irCount:(irCount + 1)
    }

    SETL irK:(irCount - 1)
    WHILE(irK > position)
    {
        SETL irSrc:(VAL token(irIds, irK - 1, " "))
        SETL irDst:(VAL token(irIds, irK, " "))
        SYNCTBL_READ_ROW rowId:(irSrc) rPrefix:irPrefix rLocal:irLocal rValue:irValue rDt:irDt rUdt:irUdt
        SYNCTBL_WRITE_ROW rowId:(irDst) rowPrefix:(irPrefix) rowLocal:(irLocal) rowValue:(irValue) rowDt:(irDt) rowUdt:(irUdt)
        SETL irK:(irK - 1)
    }

    SETL irTarget:(VAL token(irIds, position, " "))
    SYNCTBL_WRITE_ROW rowId:(irTarget) rowPrefix:(rowPrefix) rowLocal:(rowLocal) rowValue:(rowValue) rowDt:(rowDt) rowUdt:(rowUdt)
}


#------------------------------------------------------------------------------
# Canvas access
#------------------------------------------------------------------------------

# Translates an outgoing connector into table-row values; ok = 0 if not supported
PROCEDURE global SYNCTBL_READ_CONNECTOR connId: integer rPrefix: reference rLocal: reference rValue: reference rDt: reference rUdt: reference ok: reference
{
    SETL ok:(0)
    SETL rPrefix:("")
    SETL rLocal:("")
    SETL rValue:("")
    SETL rDt:("")
    SETL rUdt:("")
    SETL rcTmp:("")
    SETL rcIdent:("")

    CC "Core" GET_CLASS_ID objid:(connId)
    CC "Core" GET_CLASS_NAME classid:(classid)
    SETL rcConnClass:(classname)

    CC "Core" GET_CONNECTOR_ENDPOINTS objid:(connId)
    SETL rcToObj:(toobjid)
    CC "Core" GET_CLASS_ID objid:(rcToObj)
    CC "Core" GET_CLASS_NAME classid:(classid)
    SETL rcToClass:(classname)

    IF(rcConnClass = "RelatedTo")
    {
        SYNCTBL_GET_ATTR objId:(connId) attrName:("Prefix") result:rcTmp
        SETL rPrefix:(rcTmp)
        SYNCTBL_GET_ATTR objId:(connId) attrName:("Local identifier") result:rcTmp
        SETL rLocal:(rcTmp)
        SYNCTBL_GET_NODE_IDENT objId:(rcToObj) result:rcIdent
        SETL rValue:(rcIdent)
        SETL rDt:("URI")
        SETL ok:(1)
    }
    ELSIF(rcConnClass = "IsOfType")
    {
        SYNCTBL_GET_NODE_IDENT objId:(rcToObj) result:rcIdent
        SETL rPrefix:("")
        SETL rLocal:("a")
        SETL rValue:(rcIdent)
        SETL rDt:("URI")
        SETL ok:(1)
    }
    ELSIF(rcConnClass = "IsTheSame")
    {
        SYNCTBL_GET_NODE_IDENT objId:(rcToObj) result:rcIdent
        SETL rPrefix:("owl:")
        SETL rLocal:("sameAs")
        SETL rValue:(rcIdent)
        SETL rDt:("URI")
        SETL ok:(1)
    }
    ELSIF(rcConnClass = "HasAttribute" AND rcToClass = "Data")
    {
        SYNCTBL_GET_ATTR objId:(connId) attrName:("Prefix") result:rcTmp
        SETL rPrefix:(rcTmp)
        SYNCTBL_GET_ATTR objId:(connId) attrName:("Local identifier") result:rcTmp
        SETL rLocal:(rcTmp)
        SYNCTBL_GET_ATTR objId:(rcToObj) attrName:("Value") result:rcTmp
        SETL rValue:(rcTmp)

        SETL rcHasUdt:(0)
        CC "Core" GET_INTERREF objid:(rcToObj) attrname:("User-defined datatypes") index:(0)
        IF(ecode = 0)
        {
            IF(count > 0)
            {
                SETL rcHasUdt:(1)
                SETL rcUdtObj:(tobjid)
            }
        }

        IF(rcHasUdt = 1)
        {
            SYNCTBL_GET_NODE_IDENT objId:(rcUdtObj) result:rcIdent
            SETL rDt:("-")
            SETL rUdt:(rcIdent)
        }
        ELSE
        {
            SYNCTBL_GET_ATTR objId:(rcToObj) attrName:("Built-in data") result:rcTmp
            SYNCTBL_TRIM str:(rcTmp) result:rcTmp
            IF(rcTmp = "")
            {
                # RDF 1.1: a literal without datatype is an xsd:string literal
                SETL rcTmp:("xsd:string")
            }
            SETL rDt:(rcTmp)
        }
        SETL ok:(1)
    }
}

# Searches a DatatypeNode with the given identifier: first in the active model,
# then in the other opened models. result = object id or -1
PROCEDURE global SYNCTBL_FIND_DATATYPE_OBJ modelId: integer udtIdent: string result: reference
{
    SETL result:(-1)
    SETL fdTarget:("")
    SETL fdIdent:("")
    SYNCTBL_NORMALIZE_RESOURCE value:(udtIdent) result:fdTarget

    SETL fdModels:(STR modelId)
    CC "Modeling" GET_OPENED_MODELS
    IF(ecode = 0)
    {
        FOR fdOpenedModel in:(modelids)
        {
            IF((VAL fdOpenedModel) != modelId)
            {
                SETL fdModels:(fdModels + " " + fdOpenedModel)
            }
        }
    }

    FOR fdModel in:(fdModels)
    {
        IF(result = -1)
        {
            CC "Core" GET_ALL_OBJS_OF_CLASSNAME modelid:(VAL fdModel) classname:("DatatypeNode")
            IF(ecode = 0)
            {
                SETL fdObjIds:(objids)
                FOR fdObj in:(fdObjIds)
                {
                    IF(result = -1)
                    {
                        SYNCTBL_GET_NODE_IDENT objId:(VAL fdObj) result:fdIdent
                        IF(fdIdent = fdTarget)
                        {
                            SETL result:(VAL fdObj)
                        }
                    }
                }
            }
        }
    }
}

# Reads x / y / w / h (in cm) from the Position attribute of a node
PROCEDURE global SYNCTBL_PARSE_POSITION objId: integer px: reference py: reference pw: reference ph: reference
{
    SETL px:(0.0)
    SETL py:(0.0)
    SETL pw:(3.0)
    SETL ph:(1.0)
    CC "Core" GET_ATTR_VAL objid:(objId) attrname:("Position")
    SETL ppPos:(val)
    FOR ppTok in:(ppPos) sep:(" ")
    {
        IF((LEN ppTok) > 2)
        {
            SETL ppTag:(copy(ppTok, 0, 2))
            SETL ppNum:(VAL (replall(copy(ppTok, 2, (LEN ppTok) - 2), "cm", "")))
            IF(ppTag = "x:")
            {
                SETL px:(ppNum)
            }
            ELSIF(ppTag = "y:")
            {
                SETL py:(ppNum)
            }
            ELSIF(ppTag = "w:")
            {
                SETL pw:(ppNum)
            }
            ELSIF(ppTag = "h:")
            {
                SETL ph:(ppNum)
            }
        }
    }
}

# Position string for the n-th new node placed to the right of srcObjId.
# The size is taken from sizeRefObjId (normally the element holding the table);
# withSize = 0 omits w / h so the node keeps its class default size (HelperNodes)
PROCEDURE global SYNCTBL_NEW_NODE_POSITION srcObjId: integer sizeRefObjId: integer stackIndex: integer withSize: integer result: reference
{
    SETL npX:(0.0)
    SETL npY:(0.0)
    SETL npW:(3.0)
    SETL npH:(1.0)
    SETL npDummyW:(0.0)
    SETL npDummyH:(0.0)
    SETL npDummyX:(0.0)
    SETL npDummyY:(0.0)

    SYNCTBL_PARSE_POSITION objId:(srcObjId) px:npX py:npY pw:npDummyW ph:npDummyH
    SYNCTBL_PARSE_POSITION objId:(sizeRefObjId) px:npDummyX py:npDummyY pw:npW ph:npH

    # HelperNodes are small circles: enlarge the size used for the new nodes
    CC "Core" GET_CLASS_ID objid:(sizeRefObjId)
    CC "Core" GET_CLASS_NAME classid:(classid)
    IF(classname = "HelperNode")
    {
        SETL npW:(2 * npW)
        SETL npH:(3.5 * npH)
    }

    SETL npX:(npX + 3)
    SETL npY:(npY + 1.5 * stackIndex)
    IF(withSize = 1)
    {
        SETL result:("NODE x:" + STR npX + "cm y:" + STR npY + "cm w:" + STR npW + "cm h:" + STR npH + "cm")
    }
    ELSE
    {
        SETL result:("NODE x:" + STR npX + "cm y:" + STR npY + "cm")
    }
}

# Creates the node + connector for a table row, starting from srcObjId
# (the element holding the table, or a blank node); created = 1 on success
PROCEDURE global SYNCTBL_CREATE_FROM_ROW modelId: integer srcObjId: integer sizeRefObjId: integer stackIndex: integer udtAttrId: integer rowPrefix: string rowLocal: string rowValue: string rowDt: string rowUdt: string created: reference warnings: reference
{
    SETL created:(0)
    SETL crPred:("")
    SETL crPos:("")
    SETL crPosPlain:("")
    SETL crVal:("")
    SETL crUdtObj:(-1)
    SETL crRowText:(rowPrefix + rowLocal + " " + rowValue)

    CC "Core" GET_CLASS_ID classname:("ThingIdentifier")
    SETL crThingIdentifierClassId:(classid)
    CC "Core" GET_CLASS_ID classname:("HelperNode")
    SETL crHelperNodeClassId:(classid)
    CC "Core" GET_CLASS_ID classname:("Data")
    SETL crDataClassId:(classid)
    CC "Core" GET_CLASS_ID classname:("ThingType")
    SETL crThingTypeClassId:(classid)
    CC "Core" GET_CLASS_ID classname:("RelatedTo")
    SETL crRelatedToClassId:(classid)
    CC "Core" GET_CLASS_ID classname:("HasAttribute")
    SETL crHasAttributeClassId:(classid)
    CC "Core" GET_CLASS_ID classname:("IsOfType")
    SETL crIsOfTypeClassId:(classid)
    CC "Core" GET_CLASS_ID classname:("IsTheSame")
    SETL crIsTheSameClassId:(classid)

    SETL crLocalTrim:("")
    SETL crValueTrim:("")
    SYNCTBL_TRIM str:(rowDt) result:rowDt
    SYNCTBL_TRIM str:(rowUdt) result:rowUdt
    SYNCTBL_TRIM str:(rowLocal) result:crLocalTrim
    SYNCTBL_TRIM str:(rowValue) result:crValueTrim
    SYNCTBL_NORMALIZE_PREDICATE predPrefix:(rowPrefix) predLocal:(rowLocal) result:crPred
    SYNCTBL_NEW_NODE_POSITION srcObjId:(srcObjId) sizeRefObjId:(sizeRefObjId) stackIndex:(stackIndex) withSize:(1) result:crPos
    SYNCTBL_NEW_NODE_POSITION srcObjId:(srcObjId) sizeRefObjId:(sizeRefObjId) stackIndex:(stackIndex) withSize:(0) result:crPosPlain

    # never create anything for structural / empty rows ("(", ")", "[", "]", no predicate, no value)
    IF(crLocalTrim = "" OR crValueTrim = "" OR rowDt = "(" OR rowDt = ")" OR rowDt = "[" OR rowDt = "]")
    {
        SETL created:(0)
    }
    ELSIF(rowUdt != "" OR rowDt != "URI")
    {
        #------------------------- literal -> Data node + HasAttribute
        SETL crCanCreate:(1)
        IF(rowUdt != "")
        {
            SYNCTBL_FIND_DATATYPE_OBJ modelId:(modelId) udtIdent:(rowUdt) result:crUdtObj
            IF(crUdtObj = -1)
            {
                SETL crCanCreate:(0)
                SETL warnings:(warnings + "- " + crRowText + ": user-defined datatype '" + rowUdt + "' not found (no DatatypeNode with this URI in the opened models).\n")
            }
            ELSIF(udtAttrId = -1)
            {
                SETL crCanCreate:(0)
                SETL warnings:(warnings + "- " + crRowText + ": class Data has no attribute 'User-defined datatypes'.\n")
            }
        }

        IF(crCanCreate = 1)
        {
            CC "Core" CREATE_OBJ modelid:(modelId) classid:(crDataClassId)
            IF(ecode != 0)
            {
                SETL warnings:(warnings + "- " + crRowText + ": the Data node could not be created.\n")
            }
            ELSE
            {
                SETL crNewObj:(objid)
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("Position") val:(crPos)
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("Value") val:(rowValue)
                IF(rowUdt != "")
                {
                    CC "Core" ADD_INTERREF objid:(crNewObj) attrid:(udtAttrId) tobjid:(crUdtObj)
                    IF(ecode != 0)
                    {
                        SETL warnings:(warnings + "- " + crRowText + ": the user-defined datatype reference could not be set.\n")
                    }
                }
                ELSIF(rowDt != "")
                {
                    CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("Built-in data") val:(rowDt)
                    IF(ecode != 0)
                    {
                        SETL warnings:(warnings + "- " + crRowText + ": datatype '" + rowDt + "' is not a valid 'Built-in data' value.\n")
                    }
                }
                CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(srcObjId) toobjid:(crNewObj) classid:(crHasAttributeClassId)
                SETL crNewConn:(objid)
                CC "Core" SET_ATTR_VAL objid:(crNewConn) attrname:("Prefix") val:(rowPrefix)
                CC "Core" SET_ATTR_VAL objid:(crNewConn) attrname:("Local identifier") val:(rowLocal)
                SETL created:(1)
            }
        }
    }
    ELSE
    {
        #------------------------- resource -> node + RelatedTo / IsOfType / IsTheSame
        SYNCTBL_TRIM str:(rowValue) result:crVal
        SYNCTBL_NORMALIZE_RESOURCE value:(crVal) result:crVal

        SETL crIsHelper:(0)
        SYNCTBL_STARTS_WITH str:(crVal) startStr:("_:") result:crIsHelper
        SETL crIsIri:(0)
        SYNCTBL_STARTS_WITH str:(crVal) startStr:("<") result:crIsIri

        IF(crPred = "a")
        {
            SETL crNodeClassId:(crThingTypeClassId)
            SETL crConnClassId:(crIsOfTypeClassId)
            SETL crSetConnAttrs:(0)
            SETL crIsHelper:(0)
        }
        ELSIF(crPred = "owl:sameAs")
        {
            SETL crNodeClassId:(crThingIdentifierClassId)
            SETL crConnClassId:(crIsTheSameClassId)
            SETL crSetConnAttrs:(0)
            SETL crIsHelper:(0)
        }
        ELSIF(crIsHelper = 1)
        {
            SETL crNodeClassId:(crHelperNodeClassId)
            SETL crConnClassId:(crRelatedToClassId)
            SETL crSetConnAttrs:(1)
        }
        ELSE
        {
            SETL crNodeClassId:(crThingIdentifierClassId)
            SETL crConnClassId:(crRelatedToClassId)
            SETL crSetConnAttrs:(1)
        }

        # ThingIdentifiers and ThingTypes keep their default width / height (position only, no w / h)
        IF(crNodeClassId = crThingIdentifierClassId OR crNodeClassId = crThingTypeClassId)
        {
            SETL crNodePos:(crPosPlain)
        }
        ELSE
        {
            SETL crNodePos:(crPos)
        }

        CC "Core" CREATE_OBJ modelid:(modelId) classid:(crNodeClassId)
        IF(ecode != 0)
        {
            SETL warnings:(warnings + "- " + crRowText + ": the target node could not be created.\n")
        }
        ELSE
        {
            SETL crNewObj:(objid)

            IF(crIsHelper = 1)
            {
                # "_:b1" -> Local identifier "b1"; HelperNodes keep their default size
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("Position") val:(crPosPlain)
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("Local identifier") val:(copy(crVal, 2, (LEN crVal) - 2))
            }
            ELSIF(crIsIri = 1)
            {
                # full IRI: only the URI attribute can be filled
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("Position") val:(crNodePos)
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("URI") val:(crVal)
            }
            ELSE
            {
                # ":Mike" -> Prefix ":" + Local identifier "Mike"
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("Position") val:(crNodePos)
                SETL crColon:(search(crVal, ":", 0))
                SETL crObjPrefix:(copy(crVal, 0, crColon + 1))
                SETL crObjLocal:(copy(crVal, crColon + 1, (LEN crVal) - crColon - 1))
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("Prefix") val:(crObjPrefix)
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("Local identifier") val:(crObjLocal)
                CC "Core" SET_ATTR_VAL objid:(crNewObj) attrname:("URI") val:(crVal)
            }

            CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(srcObjId) toobjid:(crNewObj) classid:(crConnClassId)
            IF(ecode != 0)
            {
                SETL warnings:(warnings + "- " + crRowText + ": the connector could not be created.\n")
            }
            ELSE
            {
                SETL crNewConn:(objid)
                IF(crSetConnAttrs = 1)
                {
                    CC "Core" SET_ATTR_VAL objid:(crNewConn) attrname:("Prefix") val:(rowPrefix)
                    CC "Core" SET_ATTR_VAL objid:(crNewConn) attrname:("Local identifier") val:(rowLocal)
                }
            }
            SETL created:(1)
        }
    }
}

# Creates an anonymous blank node (HelperNode with empty local identifier) and
# links it to srcObjId with a RelatedTo connector; newNodeId = -1 on failure
PROCEDURE global SYNCTBL_CREATE_BLANK_NODE modelId: integer srcObjId: integer stackIndex: integer predPrefix: string predLocal: string newNodeId: reference warnings: reference
{
    SETL newNodeId:(-1)
    SETL cbnPos:("")

    CC "Core" GET_CLASS_ID classname:("HelperNode")
    SETL cbnHelperClassId:(classid)
    CC "Core" GET_CLASS_ID classname:("RelatedTo")
    SETL cbnRelatedToClassId:(classid)

    SYNCTBL_NEW_NODE_POSITION srcObjId:(srcObjId) sizeRefObjId:(srcObjId) stackIndex:(stackIndex) withSize:(0) result:cbnPos

    CC "Core" CREATE_OBJ modelid:(modelId) classid:(cbnHelperClassId)
    IF(ecode != 0)
    {
        SETL warnings:(warnings + "- " + predPrefix + predLocal + " [ ... ]: the blank node could not be created.\n")
    }
    ELSE
    {
        SETL cbnNode:(objid)
        CC "Core" SET_ATTR_VAL objid:(cbnNode) attrname:("Position") val:(cbnPos)
        CC "Core" CREATE_CONNECTOR modelid:(modelId) fromobjid:(srcObjId) toobjid:(cbnNode) classid:(cbnRelatedToClassId)
        IF(ecode != 0)
        {
            SETL warnings:(warnings + "- " + predPrefix + predLocal + " [ ... ]: the connector to the blank node could not be created.\n")
        }
        ELSE
        {
            SETL cbnConn:(objid)
            CC "Core" SET_ATTR_VAL objid:(cbnConn) attrname:("Prefix") val:(predPrefix)
            CC "Core" SET_ATTR_VAL objid:(cbnConn) attrname:("Local identifier") val:(predLocal)
        }
        SETL newNodeId:(cbnNode)
    }
}

# Appends a "[ ... ]" group to the table for a canvas blank node
PROCEDURE global SYNCTBL_APPEND_GROUP objId: integer attrId: integer bnConnId: integer bnNodeId: integer rowsAdded: reference
{
    SETL agPrefix:("")
    SETL agLocal:("")
    SETL agP:("")
    SETL agL:("")
    SETL agV:("")
    SETL agD:("")
    SETL agU:("")
    SETL agOk:(0)
    SETL agKey:("")
    SETL agExists:(0)
    SETL agKeys:("\n")

    SYNCTBL_GET_ATTR objId:(bnConnId) attrName:("Prefix") result:agPrefix
    SYNCTBL_GET_ATTR objId:(bnConnId) attrName:("Local identifier") result:agLocal

    SYNCTBL_ADD_TABLE_ROW objId:(objId) attrId:(attrId) rowPrefix:(agPrefix) rowLocal:(agLocal) rowValue:("") rowDt:("[") rowUdt:("")
    SETL rowsAdded:(rowsAdded + 1)

    CC "Core" GET_CONNECTORS objid:(bnNodeId) out
    SETL agConnIds:(objids)
    FOR agConn in:(agConnIds)
    {
        SYNCTBL_READ_CONNECTOR connId:(VAL agConn) rPrefix:agP rLocal:agL rValue:agV rDt:agD rUdt:agU ok:agOk
        IF(agOk = 1)
        {
            SYNCTBL_MAKE_KEY rowPrefix:(agP) rowLocal:(agL) rowValue:(agV) rowDt:(agD) rowUdt:(agU) result:agKey
            IF(agKey != "")
            {
                SYNCTBL_KEY_EXISTS keySet:(agKeys) key:(agKey) result:agExists
                IF(agExists = 0)
                {
                    SYNCTBL_ADD_TABLE_ROW objId:(objId) attrId:(attrId) rowPrefix:(agP) rowLocal:(agL) rowValue:(agV) rowDt:(agD) rowUdt:(agU)
                    SETL agKeys:(agKeys + agKey + "\n")
                    SETL rowsAdded:(rowsAdded + 1)
                }
            }
        }
    }

    SYNCTBL_ADD_TABLE_ROW objId:(objId) attrId:(attrId) rowPrefix:("") rowLocal:("") rowValue:("") rowDt:("]") rowUdt:("")
    SETL rowsAdded:(rowsAdded + 1)
}


#------------------------------------------------------------------------------
# Synchronisation
#------------------------------------------------------------------------------

PROCEDURE global SYNCTBL_RUN modelId: integer selObjId: integer attrId: integer debugMode: integer
{
    SETL warnings:("")
    SETL debugText:("")
    SETL rowsAdded:(0)
    SETL nodesCreated:(0)

    SETL rPrefix:("")
    SETL rLocal:("")
    SETL rValue:("")
    SETL rDt:("")
    SETL rUdt:("")
    SETL rKey:("")
    SETL rOk:(0)
    SETL rExists:(0)
    SETL rCreated:(0)
    SETL rPrefixTrim:("")
    SETL rLocalTrim:("")
    SETL rDtTrim:("")
    SETL rPred:("")
    SETL rIdent:("")
    SETL rScore:(0)
    SETL newBnNode:(-1)

    CC "Core" GET_CLASS_ID classname:("Data")
    CC "Core" GET_ATTR_ID classid:(classid) attrname:("User-defined datatypes")
    IF(ecode = 0)
    {
        SETL udtAttrId:(attrid)
    }
    ELSE
    {
        SETL udtAttrId:(-1)
    }

    #==== 1. parse the table ===================================================
    CC "Core" GET_ALL_REC_ATTR_ROW_IDS objid:(selObjId) attrid:(attrId)
    SETL tableRowIds:(rowids)
    SETL rowCount:(0)
    FOR tblRow in:(tableRowIds)
    {
        SETL rowCount:(rowCount + 1)
    }

    # groups "[ ... ]" found in the table
    SETL grpPrefix:(array(rowCount + 1))
    SETL grpLocal:(array(rowCount + 1))
    SETL grpPred:(array(rowCount + 1))
    SETL grpCloseIdx:(array(rowCount + 1))
    SETL grpInnerKeys:(array(rowCount + 1))
    SETL grpInnerRows:(array(rowCount + 1))
    SETL grpPair:(array(rowCount + 1))
    SETL groupCount:(0)

    SETL curGroup:(-1)
    SETL inSection:(0)
    SETL structErr:("")
    SETL rowIdx:(0)
    SETL tableKeys:("\n")
    SETL topRowIds:("")

    SETL debugText:(debugText + "TABLE ROWS  [Prefix][LocalId][Value][Datatype][UDT] -> key\n")
    FOR tblRow in:(tableRowIds)
    {
        SYNCTBL_READ_ROW rowId:(VAL tblRow) rPrefix:rPrefix rLocal:rLocal rValue:rValue rDt:rDt rUdt:rUdt
        SYNCTBL_TRIM str:(rPrefix) result:rPrefixTrim
        SYNCTBL_TRIM str:(rLocal) result:rLocalTrim
        SYNCTBL_TRIM str:(rDt) result:rDtTrim
        SETL rKey:("")
        SETL rowNo:("Row " + STR (rowIdx + 1))

        IF(structErr = "")
        {
            IF(inSection = 1)
            {
                # "( ... )" list section: rows are ignored, but known (no re-adding from canvas)
                IF(rDtTrim = ")")
                {
                    SETL inSection:(0)
                }
                ELSE
                {
                    SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) result:rKey
                    IF(rKey != "")
                    {
                        SETL tableKeys:(tableKeys + rKey + "\n")
                    }
                }
            }
            ELSIF(rDtTrim = "(")
            {
                IF(curGroup != -1)
                {
                    SETL structErr:(rowNo + ": a list '(' inside a blank-node group [ ... ] is not supported.")
                }
                ELSE
                {
                    SETL inSection:(1)
                }
            }
            ELSIF(rDtTrim = ")")
            {
                SETL structErr:(rowNo + ": ')' without a matching '('.")
            }
            ELSIF(rDtTrim = "[")
            {
                IF(curGroup != -1)
                {
                    SETL structErr:(rowNo + ": nested blank nodes are not supported ('[' inside another '[' ... ']').")
                }
                ELSIF(rLocalTrim = "")
                {
                    SETL structErr:(rowNo + ": the '[' row needs a predicate (AttributeLocalIdentifier).")
                }
                ELSE
                {
                    SETL curGroup:(groupCount)
                    SYNCTBL_NORMALIZE_PREDICATE predPrefix:(rPrefixTrim) predLocal:(rLocalTrim) result:rPred
                    SETL grpPrefix[curGroup]:(rPrefixTrim)
                    SETL grpLocal[curGroup]:(rLocalTrim)
                    SETL grpPred[curGroup]:(rPred)
                    SETL grpCloseIdx[curGroup]:(-1)
                    SETL grpInnerKeys[curGroup]:("\n")
                    SETL grpInnerRows[curGroup]:("")
                    SETL grpPair[curGroup]:(-1)
                    SETL groupCount:(groupCount + 1)
                }
            }
            ELSIF(rDtTrim = "]")
            {
                IF(curGroup = -1)
                {
                    SETL structErr:(rowNo + ": ']' without a matching '['.")
                }
                ELSE
                {
                    SETL grpCloseIdx[curGroup]:(rowIdx)
                    SETL curGroup:(-1)
                }
            }
            ELSE
            {
                SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) result:rKey
                IF(rKey != "")
                {
                    IF(curGroup != -1)
                    {
                        SYNCTBL_KEY_EXISTS keySet:(grpInnerKeys[curGroup]) key:(rKey) result:rExists
                        IF(rExists = 0)
                        {
                            SETL grpInnerKeys[curGroup]:(grpInnerKeys[curGroup] + rKey + "\n")
                            IF(grpInnerRows[curGroup] = "")
                            {
                                SETL grpInnerRows[curGroup]:(tblRow)
                            }
                            ELSE
                            {
                                SETL grpInnerRows[curGroup]:(grpInnerRows[curGroup] + " " + tblRow)
                            }
                        }
                    }
                    ELSE
                    {
                        SETL tableKeys:(tableKeys + rKey + "\n")
                        IF(topRowIds = "")
                        {
                            SETL topRowIds:(tblRow)
                        }
                        ELSE
                        {
                            SETL topRowIds:(topRowIds + " " + tblRow)
                        }
                    }
                }
            }
        }

        SETL debugText:(debugText + "[" + rPrefix + "][" + rLocal + "][" + rValue + "][" + rDt + "][" + rUdt + "] -> " + rKey + "\n")
        SETL rowIdx:(rowIdx + 1)
    }

    IF(structErr = "" AND curGroup != -1)
    {
        SETL structErr:("The blank-node group '" + grpPrefix[curGroup] + grpLocal[curGroup] + " [' is not closed with ']'.")
    }
    IF(structErr = "" AND inSection = 1)
    {
        SETL structErr:("A list '(' is not closed with ')'.")
    }

    IF(structErr != "")
    {
        CC "AdoScript" WARNINGBOX ("Nothing was synchronised because the table structure is invalid:\n\n" + structErr)
    }
    ELSE
    {
        #==== 2. parse the canvas ==============================================
        CC "Core" GET_CONNECTORS objid:(selObjId) out
        SETL outConnIds:(objids)
        SETL connCount:(0)
        FOR outConn in:(outConnIds)
        {
            SETL connCount:(connCount + 1)
        }

        # blank nodes (HelperNodes reached through RelatedTo) found on the canvas
        SETL cbConn:(array(connCount + 1))
        SETL cbNode:(array(connCount + 1))
        SETL cbPrefix:(array(connCount + 1))
        SETL cbLocal:(array(connCount + 1))
        SETL cbPred:(array(connCount + 1))
        SETL cbSimpleKey:(array(connCount + 1))
        SETL cbInnerKeys:(array(connCount + 1))
        SETL cbInnerConns:(array(connCount + 1))
        SETL cbInnerCount:(array(connCount + 1))
        SETL cbPair:(array(connCount + 1))
        SETL bnCount:(0)

        SETL canvasKeys:("\n")
        SETL canvasTopConns:("")

        SETL debugText:(debugText + "\nCANVAS CONNECTORS  [Prefix][LocalId][Value][Datatype][UDT] -> key\n")
        FOR outConn in:(outConnIds)
        {
            SETL cConn:(VAL outConn)
            CC "Core" GET_CLASS_ID objid:(cConn)
            CC "Core" GET_CLASS_NAME classid:(classid)
            SETL cConnClass:(classname)
            CC "Core" GET_CONNECTOR_ENDPOINTS objid:(cConn)
            SETL cToObj:(toobjid)
            CC "Core" GET_CLASS_ID objid:(cToObj)
            CC "Core" GET_CLASS_NAME classid:(classid)
            SETL cToClass:(classname)

            IF(cConnClass = "RelatedTo" AND cToClass = "HelperNode")
            {
                #---- blank node
                SETL bIdx:(bnCount)
                SYNCTBL_GET_ATTR objId:(cConn) attrName:("Prefix") result:rPrefix
                SYNCTBL_GET_ATTR objId:(cConn) attrName:("Local identifier") result:rLocal
                SYNCTBL_TRIM str:(rPrefix) result:rPrefixTrim
                SYNCTBL_TRIM str:(rLocal) result:rLocalTrim
                SYNCTBL_NORMALIZE_PREDICATE predPrefix:(rPrefixTrim) predLocal:(rLocalTrim) result:rPred

                SETL cbConn[bIdx]:(cConn)
                SETL cbNode[bIdx]:(cToObj)
                SETL cbPrefix[bIdx]:(rPrefixTrim)
                SETL cbLocal[bIdx]:(rLocalTrim)
                SETL cbPred[bIdx]:(rPred)
                SETL cbPair[bIdx]:(-1)

                # a labelled blank node also matches an old-style row ":p _:b1 URI"
                SETL cbSimpleKey[bIdx]:("")
                SYNCTBL_GET_NODE_IDENT objId:(cToObj) result:rIdent
                IF(rIdent != "")
                {
                    SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rIdent) rowDt:("URI") rowUdt:("") result:rKey
                    SETL cbSimpleKey[bIdx]:(rKey)
                    IF(rKey != "")
                    {
                        SETL canvasKeys:(canvasKeys + rKey + "\n")
                    }
                }

                SETL debugText:(debugText + "[" + rPrefix + "][" + rLocal + "][" + rIdent + "][[][] -> blank node #" + STR bIdx + "\n")

                # inner relations of the blank node
                SETL cbInnerKeys[bIdx]:("\n")
                SETL cbInnerConns[bIdx]:("")
                SETL cbInnerCount[bIdx]:(0)
                CC "Core" GET_CONNECTORS objid:(cToObj) out
                SETL cInnerConnIds:(objids)
                FOR innerConn in:(cInnerConnIds)
                {
                    SYNCTBL_READ_CONNECTOR connId:(VAL innerConn) rPrefix:rPrefix rLocal:rLocal rValue:rValue rDt:rDt rUdt:rUdt ok:rOk
                    IF(rOk = 1)
                    {
                        SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) result:rKey
                        SETL debugText:(debugText + "    [" + rPrefix + "][" + rLocal + "][" + rValue + "][" + rDt + "][" + rUdt + "] -> " + rKey + "\n")
                        IF(rKey != "")
                        {
                            SYNCTBL_KEY_EXISTS keySet:(cbInnerKeys[bIdx]) key:(rKey) result:rExists
                            IF(rExists = 0)
                            {
                                SETL cbInnerKeys[bIdx]:(cbInnerKeys[bIdx] + rKey + "\n")
                                IF(cbInnerConns[bIdx] = "")
                                {
                                    SETL cbInnerConns[bIdx]:(innerConn)
                                }
                                ELSE
                                {
                                    SETL cbInnerConns[bIdx]:(cbInnerConns[bIdx] + " " + innerConn)
                                }
                                SETL cbInnerCount[bIdx]:(cbInnerCount[bIdx] + 1)
                            }
                        }
                        ELSIF(rDt = "URI" AND rValue = "")
                        {
                            SETL warnings:(warnings + "- blank node " + rPrefixTrim + rLocalTrim + ": the connector " + rPrefix + rLocal + " points to an element without identifier (e.g. a nested blank node) and was ignored.\n")
                        }
                    }
                }
                SETL bnCount:(bnCount + 1)
            }
            ELSE
            {
                #---- simple relation
                SYNCTBL_READ_CONNECTOR connId:(cConn) rPrefix:rPrefix rLocal:rLocal rValue:rValue rDt:rDt rUdt:rUdt ok:rOk
                IF(rOk = 1)
                {
                    SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) result:rKey
                    SETL debugText:(debugText + "[" + rPrefix + "][" + rLocal + "][" + rValue + "][" + rDt + "][" + rUdt + "] -> " + rKey + "\n")
                    IF(rKey != "")
                    {
                        SETL canvasKeys:(canvasKeys + rKey + "\n")
                        IF(canvasTopConns = "")
                        {
                            SETL canvasTopConns:(outConn)
                        }
                        ELSE
                        {
                            SETL canvasTopConns:(canvasTopConns + " " + outConn)
                        }
                    }
                }
            }
        }

        #==== 3. pair table groups with canvas blank nodes =====================
        # pass 1: same predicate and at least one common inner relation (best score)
        # pass 2: same predicate only
        IF(groupCount > 0 AND bnCount > 0)
        {
            FOR pass from:(1) to:(2)
            {
                FOR gIdx from:(0) to:(groupCount - 1)
                {
                    IF(grpPair[gIdx] = -1)
                    {
                        SETL bestB:(-1)
                        SETL bestScore:(-1)
                        FOR bIdx from:(0) to:(bnCount - 1)
                        {
                            IF(cbPair[bIdx] = -1)
                            {
                                IF(cbPred[bIdx] = grpPred[gIdx])
                                {
                                    SYNCTBL_COUNT_COMMON keySetA:(grpInnerKeys[gIdx]) keySetB:(cbInnerKeys[bIdx]) result:rScore
                                    IF(rScore > bestScore)
                                    {
                                        SETL bestScore:(rScore)
                                        SETL bestB:(bIdx)
                                    }
                                }
                            }
                        }
                        IF(bestB != -1)
                        {
                            IF(bestScore > 0 OR pass = 2)
                            {
                                SETL grpPair[gIdx]:(bestB)
                                SETL cbPair[bestB]:(gIdx)
                            }
                        }
                    }
                }
            }
        }

        IF(groupCount > 0)
        {
            SETL debugText:(debugText + "\nGROUPS\n")
            FOR gIdx from:(0) to:(groupCount - 1)
            {
                SETL debugText:(debugText + "group #" + STR gIdx + " " + grpPred[gIdx] + " -> blank node #" + STR grpPair[gIdx] + "\n")
            }
        }

        #==== 4. table -> canvas ===============================================
        SETL stackIndex:(0)

        # 4a. simple rows
        FOR topRow in:(topRowIds)
        {
            SETL rKey:("")
            IF(topRow != "")
            {
                SYNCTBL_READ_ROW rowId:(VAL topRow) rPrefix:rPrefix rLocal:rLocal rValue:rValue rDt:rDt rUdt:rUdt
                SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) result:rKey
            }
            SETL rExists:(1)
            IF(rKey != "")
            {
                SYNCTBL_KEY_EXISTS keySet:(canvasKeys) key:(rKey) result:rExists
            }
            IF(rExists = 0)
            {
                SYNCTBL_CREATE_FROM_ROW modelId:(modelId) srcObjId:(selObjId) sizeRefObjId:(selObjId) stackIndex:(stackIndex) udtAttrId:(udtAttrId) rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) created:rCreated warnings:warnings
                IF(rCreated = 1)
                {
                    SETL canvasKeys:(canvasKeys + rKey + "\n")
                    SETL stackIndex:(stackIndex + 1)
                    SETL nodesCreated:(nodesCreated + 1)
                }
            }
        }

        # 4b. groups
        IF(groupCount > 0)
        {
            FOR gIdx from:(0) to:(groupCount - 1)
            {
                IF(grpPair[gIdx] = -1)
                {
                    # no blank node on the canvas yet: create it with all its relations
                    SYNCTBL_CREATE_BLANK_NODE modelId:(modelId) srcObjId:(selObjId) stackIndex:(stackIndex) predPrefix:(grpPrefix[gIdx]) predLocal:(grpLocal[gIdx]) newNodeId:newBnNode warnings:warnings
                    IF(newBnNode != -1)
                    {
                        SETL nodesCreated:(nodesCreated + 1)
                        SETL childIdx:(0)
                        FOR innerRow in:(grpInnerRows[gIdx])
                        {
                            SETL rKey:("")
                            IF(innerRow != "")
                            {
                                SYNCTBL_READ_ROW rowId:(VAL innerRow) rPrefix:rPrefix rLocal:rLocal rValue:rValue rDt:rDt rUdt:rUdt
                                SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) result:rKey
                            }
                            SETL rCreated:(0)
                            IF(rKey != "")
                            {
                                SYNCTBL_CREATE_FROM_ROW modelId:(modelId) srcObjId:(newBnNode) sizeRefObjId:(selObjId) stackIndex:(childIdx) udtAttrId:(udtAttrId) rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) created:rCreated warnings:warnings
                            }
                            IF(rCreated = 1)
                            {
                                SETL childIdx:(childIdx + 1)
                                SETL nodesCreated:(nodesCreated + 1)
                            }
                        }
                        # leave room for the children before the next new node
                        IF(childIdx > 1)
                        {
                            SETL stackIndex:(stackIndex + childIdx)
                        }
                        ELSE
                        {
                            SETL stackIndex:(stackIndex + 1)
                        }
                    }
                }
                ELSE
                {
                    # blank node exists: add the relations it does not have yet
                    SETL bIdx:(grpPair[gIdx])
                    SETL childIdx:(cbInnerCount[bIdx])
                    FOR innerRow in:(grpInnerRows[gIdx])
                    {
                        SETL rKey:("")
                        IF(innerRow != "")
                        {
                            SYNCTBL_READ_ROW rowId:(VAL innerRow) rPrefix:rPrefix rLocal:rLocal rValue:rValue rDt:rDt rUdt:rUdt
                            SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) result:rKey
                        }
                        SETL rExists:(1)
                        IF(rKey != "")
                        {
                            SYNCTBL_KEY_EXISTS keySet:(cbInnerKeys[bIdx]) key:(rKey) result:rExists
                        }
                        IF(rExists = 0)
                        {
                            SYNCTBL_CREATE_FROM_ROW modelId:(modelId) srcObjId:(cbNode[bIdx]) sizeRefObjId:(selObjId) stackIndex:(childIdx) udtAttrId:(udtAttrId) rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) created:rCreated warnings:warnings
                            IF(rCreated = 1)
                            {
                                SETL childIdx:(childIdx + 1)
                                SETL nodesCreated:(nodesCreated + 1)
                            }
                        }
                    }
                }
            }
        }

        #==== 5. canvas -> table ===============================================
        # 5a. relations of paired blank nodes missing in their group: inserted
        #     before the group's ")" row; groups are processed bottom-up so the
        #     row positions of the groups above stay valid
        SETL gRev:(groupCount - 1)
        WHILE(gRev >= 0)
        {
            IF(grpPair[gRev] != -1)
            {
                SETL bIdx:(grpPair[gRev])
                SETL insertPos:(grpCloseIdx[gRev])
                FOR innerConn in:(cbInnerConns[bIdx])
                {
                    SETL rKey:("")
                    IF(innerConn != "")
                    {
                        SYNCTBL_READ_CONNECTOR connId:(VAL innerConn) rPrefix:rPrefix rLocal:rLocal rValue:rValue rDt:rDt rUdt:rUdt ok:rOk
                        SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) result:rKey
                    }
                    IF(rKey != "")
                    {
                        SYNCTBL_KEY_EXISTS keySet:(grpInnerKeys[gRev]) key:(rKey) result:rExists
                        IF(rExists = 0)
                        {
                            SYNCTBL_INSERT_ROW objId:(selObjId) attrId:(attrId) position:(insertPos) rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt)
                            SETL insertPos:(insertPos + 1)
                            SETL grpInnerKeys[gRev]:(grpInnerKeys[gRev] + rKey + "\n")
                            SETL rowsAdded:(rowsAdded + 1)
                        }
                    }
                }
            }
            SETL gRev:(gRev - 1)
        }

        # 5b. simple connectors without a row: appended
        FOR topConn in:(canvasTopConns)
        {
            SETL rKey:("")
            IF(topConn != "")
            {
                SYNCTBL_READ_CONNECTOR connId:(VAL topConn) rPrefix:rPrefix rLocal:rLocal rValue:rValue rDt:rDt rUdt:rUdt ok:rOk
                SYNCTBL_MAKE_KEY rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt) result:rKey
            }
            SETL rExists:(1)
            IF(rKey != "")
            {
                SYNCTBL_KEY_EXISTS keySet:(tableKeys) key:(rKey) result:rExists
            }
            IF(rExists = 0)
            {
                SYNCTBL_ADD_TABLE_ROW objId:(selObjId) attrId:(attrId) rowPrefix:(rPrefix) rowLocal:(rLocal) rowValue:(rValue) rowDt:(rDt) rowUdt:(rUdt)
                SETL tableKeys:(tableKeys + rKey + "\n")
                SETL rowsAdded:(rowsAdded + 1)
            }
        }

        # 5c. blank nodes without a group: appended as "[ ... ]"
        IF(bnCount > 0)
        {
            FOR bIdx from:(0) to:(bnCount - 1)
            {
                IF(cbPair[bIdx] = -1)
                {
                    # an empty labelled blank node already listed as ":p _:b1 URI" needs no group
                    SETL skipBn:(0)
                    IF(cbSimpleKey[bIdx] != "" AND cbInnerCount[bIdx] = 0)
                    {
                        SYNCTBL_KEY_EXISTS keySet:(tableKeys) key:(cbSimpleKey[bIdx]) result:rExists
                        IF(rExists = 1)
                        {
                            SETL skipBn:(1)
                        }
                    }
                    IF(skipBn = 0)
                    {
                        SYNCTBL_APPEND_GROUP objId:(selObjId) attrId:(attrId) bnConnId:(cbConn[bIdx]) bnNodeId:(cbNode[bIdx]) rowsAdded:rowsAdded
                    }
                }
            }
        }

        IF(debugMode = 1)
        {
            SETL debugText:(debugText + "\nRows added to table: " + STR rowsAdded + "\nNodes created on canvas: " + STR nodesCreated + "\n")
            CC "AdoScript" VIEWBOX text:(debugText)
        }

        IF(warnings != "")
        {
            CC "AdoScript" WARNINGBOX ("Sync finished with warnings:\n\n" + warnings)
        }
    }
}


############## Main ##############
# 1 = show the table / canvas comparison keys in a window after syncing
SETL syncDebug:(0)

CC "Modeling" GET_ACT_MODEL
SETL syncModelId:(modelid)

IF(syncModelId = -1)
{
    CC "AdoScript" WARNINGBOX ("Please open a model first.")
}
ELSE
{
    CC "Modeling" GET_SELECTED modelid:(syncModelId)
    IF(objids = "")
    {
        CC "AdoScript" WARNINGBOX ("Please select the element whose table should be synchronised.")
    }
    ELSE
    {
        SETL syncSelObj:(VAL token(objids, 0, " "))
        CC "Core" GET_CLASS_ID objid:(syncSelObj)
        CC "Core" GET_ATTR_ID classid:(classid) attrname:("Attributes")
        IF(ecode != 0)
        {
            CC "AdoScript" WARNINGBOX ("The selected element has no 'Attributes' table.")
        }
        ELSE
        {
            SYNCTBL_RUN modelId:(syncModelId) selObjId:(syncSelObj) attrId:(attrid) debugMode:(syncDebug)
        }
    }
}
